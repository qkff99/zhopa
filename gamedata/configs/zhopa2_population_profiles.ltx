; Runtime-only task balancing data. MCM only enables the systems and selects the direct-target policy.

[geography]
; Global game-point axis used as south-to-north. Set north_sign = -1 for maps whose north points toward decreasing coordinates.
north_axis = z
north_sign = 1
default_squad_strength = 2
danger_step_penalty = 0.18
easy_step_penalty = 0.04
match_bonus = 0.10
minimum_multiplier = 0.35
; Story/special factions and non-human presence groups retain their own behavior instead of generic strength balancing.
excluded_factions = monolith, greh, isg, monster, zombied

; Optional exact overrides. Values are ranks from 1 (novice) to 5 (master).
[squad_strength]
; stalker_sim_squad_novice = 1
; stalker_sim_squad_advanced = 3

; Optional level danger overrides. They win over coordinates and are useful for custom maps.
[level_difficulty]
; l01_escape = 1
; l10_radar = 5

; Optional north-axis overrides for maps with malformed or non-comparable global coordinates.
[level_axis]
; l01_escape = -500
; l10_radar = 1200

[faction_presence]
minimum_strength = 2
ally_bonus_per_strength = 0.025
enemy_penalty_per_strength = 0.035
minimum_multiplier = 0.35
maximum_multiplier = 1.50

[conditional_targets]
balanced_min_gap = 3
balanced_reject_chance = 50
strict_min_gap = 2

