	mutant_explore_weight = { type = "track", val = 2, min = 0, max = 100, step = 1, def = 35 },
	geographic_balance_enabled = { type = "check", val = 1, def = true },
	geographic_balance_mode = { type = "radio_h", val = 2, content = { { 1, "zhopa2_balance_soft" }, { 2, "zhopa2_balance_balanced" }, { 3, "zhopa2_balance_strict" } }, def = 2, force_horz = true },
