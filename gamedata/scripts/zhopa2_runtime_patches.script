function M.clear_prefixed_table(tbl)
	if type(tbl) ~= "table" then
		return false
	end
	local keys = {}
	local managed = false
	for key in pairs(tbl) do
		if type(key) == "string" and (string.sub(key, 1, 7) == "zhopa2_" or string.sub(key, 1, 6) == "zhopa_") then
			keys[#keys + 1] = key
			managed = true
		end
	end
	for i = 1, #keys do
		tbl[keys[i]] = nil
	end
	return managed
end

function M.purge_squad_state(squad)
	local kind = type(squad)
	if kind ~= "table" and kind ~= "userdata" then
		return
	end
	local owned_target = squad.zhopa2_task ~= nil and squad.zhopa2_target ~= nil
		and tostring(squad.scripted_target) == tostring(squad.zhopa2_target)
	if type(squad.zhopa2_clear_task) == "function" then
		pcall(squad.zhopa2_clear_task, squad, "master_disabled")
	elseif owned_target then
		squad.scripted_target = nil
	end
	local memory = safe_require("zhopa2_memory")
	if memory and type(memory.reset_squad) == "function" then
		memory.reset_squad(squad)
	end
	for i = 1, #M.SQUAD_RUNTIME_FIELDS do
		squad[M.SQUAD_RUNTIME_FIELDS[i]] = nil
	end
end

function M.purge_runtime_state()
	local failures = {}
	local squads = SIMBOARD and SIMBOARD.squads
	if type(squads) == "table" then
		for id, stored in pairs(squads) do
			local squad = simboard_squad_object(id, stored)
			if squad then
				local ok, err = pcall(M.purge_squad_state, squad)
				if not ok then
					failures[#failures + 1] = "squad:" .. tostring(id) .. ":" .. tostring(err)
				end
			end
		end
	end
	if db and type(db.storage) == "table" then
		for _, storage in pairs(db.storage) do
			if type(storage) == "table" then
				local managed = M.clear_prefixed_table(storage)
				managed = M.clear_prefixed_table(storage.gather_items) or managed
				managed = M.clear_prefixed_table(storage.corpse_detection) or managed
				if managed then
					storage.has_items_to_sell = nil
					storage.trade_items = nil
				end
			end
		end
	end
	if alife_storage_manager and type(alife_storage_manager.get_state) == "function" then
		local ok, state = pcall(alife_storage_manager.get_state)
		if ok and type(state) == "table" then
			state.zhopa2_virtual_artifacts = nil
			state.zhopa2_story_north_migration = nil
			state.zhopa2_npc_quests = nil
		end
	end
	if SIMBOARD then
		SIMBOARD.zhopa2_buckets_ready = nil
		SIMBOARD.zhopa2_smarts_by_level = nil
		SIMBOARD.zhopa2_smarts_by_level_kind = nil
		SIMBOARD.zhopa2_smart_level = nil
		SIMBOARD.zhopa2_squads_by_level = nil
		SIMBOARD.zhopa2_squad_level = nil
		SIMBOARD.zhopa2_trade_smarts_by_level = nil
		SIMBOARD.zhopa2_trade_smart_level = nil
		SIMBOARD.zhopa2_trade_smart_flags = nil
		SIMBOARD.zhopa2_bucket_revision = nil
		local smarts = SIMBOARD.smarts
		if type(smarts) == "table" then
			local fields = {
				"zhopa2_artefact_available", "zhopa2_base_pull_squad_id", "zhopa2_blacklist_name",
				"zhopa2_job_capacity_monster", "zhopa2_job_capacity_stalker", "zhopa2_ownership_owner",
				"zhopa2_ownership_state", "zhopa2_presence_count", "zhopa2_presence_state",
				"zhopa2_service_allowed_roles", "zhopa2_service_count", "zhopa2_service_missing_count",
				"zhopa2_service_missing_roles", "zhopa2_service_native_roles", "zhopa2_service_needs_fill",
				"zhopa2_service_owner", "zhopa2_stalker_job_nonexclusive_sections",
			}
			for _, entry in pairs(smarts) do
				local smart = entry and (entry.smrt or entry) or nil
				if smart then
					for i = 1, #fields do
						smart[fields[i]] = nil
					end
				end
			end
		end
	end
	return #failures == 0, table.concat(failures, ",")
end

function M.unregister_runtime_callbacks()
	if UnregisterScriptCallback then
		pcall(UnregisterScriptCallback, "on_game_load", M._on_game_load)
		pcall(UnregisterScriptCallback, "actor_on_first_update", M._actor_on_first_update)
		pcall(UnregisterScriptCallback, "actor_on_update", M._actor_on_update)
	end
	runtime_ready_state.callbacks_registered = false
end

function M.reset_runtime_ready_state()
	actor_quest_target_check = false
	runtime_ready_state.items = {}
	runtime_ready_state.errors = {}
	runtime_ready_state.count = 0
	runtime_ready_state.complete = false
	runtime_ready_state.callbacks_registered = false
	runtime_ready_state.actor_first_update = false
	runtime_ready_state.warmup_until = nil
	runtime_ready_state.next_recheck_tg = 0
	zhopa2_started_modules = {}
end

function M.ensure_all(reason)
	if not M.master_enabled() then
		return false
	end
	local prev_patch_reason = current_patch_reason
	current_patch_reason = reason
	M.ensure_zhopa_modules()
	for i = 1, #ZHOPA2_RUNTIME_PATCHES do
		run_runtime_patch(ZHOPA2_RUNTIME_PATCHES[i])
	end
	runtime_mark_context()
	current_patch_reason = prev_patch_reason
	return runtime_ready_state.complete
end

function M._on_game_load()
	actor_quest_target_check = false
	if not M.master_enabled() then
		return
	end
	local task_module = tasks()
	if task_module then
		task_module.task_update_budget = {}
	end
	M.ensure_all("on_game_load")
	M.zhopa2_sync_existing_anomaly_zones("on_game_load")
end

function M._actor_on_first_update()
	if not M.master_enabled() then
		return
	end
	runtime_ready_state.actor_first_update = true
	if runtime_ready_state.warmup_until == nil then
		local now = runtime_time_ms()
		runtime_ready_state.warmup_until = now > 0 and (now + RUNTIME_READY_WARMUP_MS) or 0
	end
	M.ensure_all("actor_on_first_update")
	M.zhopa2_sync_existing_anomaly_zones("actor_on_first_update")
end

function M._actor_on_update()
	if not M.master_enabled() then
		return
	end
	if M._runtime_recheck_due("actor_on_update") then
		M.ensure_all("actor_on_update")
	end
end

function M._runtime_recheck_due(reason)
	if runtime_ready_state.complete then
		return false
	end
	if reason == "on_game_start" or reason == "on_game_load" or reason == "actor_on_first_update" then
		return true
	end
	local now = runtime_time_ms()
	if now <= 0 then
		return true
	end
	if now >= runtime_ready_state.next_recheck_tg then
		runtime_ready_state.next_recheck_tg = now + RUNTIME_READY_RECHECK_MS
		return true
	end
	return false
end

function M.runtime_not_ready_reason()
	runtime_mark_context()
	return runtime_ready_state.complete and nil or runtime_missing_item()
end

function M.runtime_ready(reason)
	if not M.master_enabled() then
		return false
	end
	if M._runtime_recheck_due(reason) then
		M.ensure_all(reason or "runtime_ready")
	else
		runtime_mark_context()
	end
	return runtime_ready_state.complete
end

function M.runtime_gate_ready(reason)
	return M.runtime_ready(reason) == true
end

function M.on_game_start()
	if not M.master_enabled() then
		return M.on_master_disable("disabled_on_game_start")
	end
	M.ensure_all("on_game_start")
	if RegisterScriptCallback then
		if UnregisterScriptCallback then
			pcall(UnregisterScriptCallback, "on_game_load", M._on_game_load)
			pcall(UnregisterScriptCallback, "actor_on_first_update", M._actor_on_first_update)
			pcall(UnregisterScriptCallback, "actor_on_update", M._actor_on_update)
		end
		RegisterScriptCallback("on_game_load", M._on_game_load)
		RegisterScriptCallback("actor_on_first_update", M._actor_on_first_update)
		RegisterScriptCallback("actor_on_update", M._actor_on_update)
		runtime_ready_state.callbacks_registered = true
		runtime_mark_context()
	end
	return true
end

function M.on_master_disable()
	M.unregister_runtime_callbacks()
	local ok, detail = M.purge_runtime_state()
	M.restore_runtime_patches()
	M.reset_runtime_ready_state()
	return ok, detail
end

function M.on_master_enable()
	M.reset_runtime_ready_state()
	return M.on_game_start()
end

function on_game_start()
	return M.on_game_start()
end

_G.zhopa2_runtime_ready = function(reason)
	return M.runtime_ready(reason)
end

_G.zhopa2_runtime_not_ready_reason = function()
	return M.runtime_not_ready_reason()
end

_G.zhopa2_runtime_patches = M
return M
