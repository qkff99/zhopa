local M = {}

local profiles_ini
local cfg_require_attempted = false
local perception_require_attempted = false
local presence_by_level = {}
local presence_by_squad = {}
local presence_ready = false
local geometry_dirty = true
local level_centers = {}
local level_meta_cache = {}
local profile_name_cache = {}
local strength_cache = {}
local on_game_load

local function cfg()
	local mod = rawget(_G, "zhopa2_cfg")
	if not mod and not cfg_require_attempted and require then
		cfg_require_attempted = true
		pcall(require, "zhopa2_cfg")
		mod = rawget(_G, "zhopa2_cfg")
	end
	return mod
end

local function perception()
	local mod = rawget(_G, "zhopa2_perception")
	if not mod and not perception_require_attempted and require then
		perception_require_attempted = true
		pcall(require, "zhopa2_perception")
		mod = rawget(_G, "zhopa2_perception")
	end
	return mod
end

local function cfg_bool(key, default)
	local mod = cfg()
	if mod and type(mod.get_bool) == "function" then
		return mod.get_bool(key, default) == true
	end
	return default == true
end

local function debug_enabled()
	return cfg_bool("debug_hud_enabled", false)
end

local function debug_printf(fmt, ...)
	if debug_enabled() and type(zhopa2_debug_printf) == "function" then
		zhopa2_debug_printf(fmt, ...)
	end
end

local function reset_runtime()
	presence_by_level = {}
	presence_by_squad = {}
	presence_ready = false
	geometry_dirty = true
	level_centers = {}
	level_meta_cache = {}
	profile_name_cache = {}
	strength_cache = {}
end

local function reload_ini()
	profiles_ini = ini_file_ex and ini_file_ex("zhopa2_population_profiles.ltx") or nil
end

local function ini_string(section, key)
	if not (profiles_ini and profiles_ini.section_exist and profiles_ini:section_exist(section)) then
		return nil
	end
	local ok, value = pcall(profiles_ini.r_string_ex, profiles_ini, section, key)
	return ok and value ~= nil and tostring(value) or nil
end

local function ini_number(section, key)
	if not (profiles_ini and profiles_ini.section_exist and profiles_ini:section_exist(section)) then
		return nil
	end
	local ok, value = pcall(profiles_ini.r_float_ex, profiles_ini, section, key)
	value = ok and tonumber(value) or nil
	return value
end

local function comma_set(value)
	if type(value) ~= "string" or value == "" then
		return {}
	end
	local out = {}
	for item in string.gmatch(value:lower(), "[^,]+") do
		local trimmed = item:gsub("^%s+", ""):gsub("%s+$", "")
		if trimmed ~= "" then
			out[trimmed] = true
		end
	end
	return out
end

local function smart_point(smart)
	local gvid = tonumber(smart and smart.m_game_vertex_id)
	if not (gvid and type(game_graph) == "function") then
		return nil
	end
	local ok_graph, graph = pcall(game_graph)
	if not (ok_graph and graph) then
		return nil
	end
	if type(graph.valid_vertex_id) == "function" then
		local ok_valid, valid = pcall(graph.valid_vertex_id, graph, gvid)
		if not (ok_valid and valid == true) then
			return nil
		end
	end
	local ok_vertex, vertex = pcall(graph.vertex, graph, gvid)
	if not (ok_vertex and vertex and type(vertex.game_point) == "function") then
		return nil
	end
	local ok_point, point = pcall(vertex.game_point, vertex)
	return ok_point and point or nil
end

local function rebuild_geometry(board)
	level_centers = {}
	level_meta_cache = {}
	geometry_dirty = false
	local sums = {}
	local axis = (ini_string("geography", "north_axis") or "z"):lower()
	if axis ~= "x" and axis ~= "z" then
		axis = "z"
	end
	for level_name, bucket in pairs(board and board.zhopa2_smarts_by_level or {}) do
		for _, smart in pairs(bucket or {}) do
			local point = smart_point(smart)
			local value = point and tonumber(axis == "x" and point.x or point.z) or nil
			if value then
				local entry = sums[level_name] or { total = 0, count = 0 }
				entry.total = entry.total + value
				entry.count = entry.count + 1
				sums[level_name] = entry
			end
		end
	end
	for level_name, entry in pairs(sums) do
		if entry.count > 0 then
			level_centers[level_name] = entry.total / entry.count
		end
	end
end

local function ensure_geometry()
	if geometry_dirty then
		local board = rawget(_G, "SIMBOARD")
		if board and board.zhopa2_buckets_ready == true then
			rebuild_geometry(board)
		end
	end
end

local function squad_section_name(squad)
	if not squad then
		return nil
	end
	if squad.zhopa2_section_name ~= nil then
		return squad.zhopa2_section_name
	end
	if type(squad.section_name) == "function" then
		local ok, section = pcall(squad.section_name, squad)
		if ok and section then
			squad.zhopa2_section_name = tostring(section)
			return squad.zhopa2_section_name
		end
	end
	return nil
end

local function squad_strength(squad)
	local squad_id = tonumber(squad and squad.id)
	local section = squad_section_name(squad)
	local cached = squad_id and strength_cache[squad_id] or nil
	if cached and cached.section == section then
		return cached.value
	end
	local value = section and ini_number("squad_strength", section) or nil
	local name = tostring(section or ""):lower()
	if not value then
		if name:find("master", 1, true) or name:find("expert", 1, true) then
			value = 5
		elseif name:find("veteran", 1, true) then
			value = 4
		elseif name:find("advanced", 1, true) then
			value = 3
		elseif name:find("regular", 1, true) then
			value = 2
		elseif name:find("novice", 1, true) then
			value = 1
		else
			value = ini_number("geography", "default_squad_strength") or 2
		end
	end
	value = math.max(1, math.min(5, tonumber(value) or 2))
	if squad_id then
		strength_cache[squad_id] = { section = section, value = value }
	end
	return value
end

local function squad_faction(squad)
	local mod = perception()
	if mod and type(mod.squad_relation_faction) == "function" then
		local ok, faction = pcall(mod.squad_relation_faction, squad)
		return ok and faction and tostring(faction) or nil
	end
	return squad and squad.player_id and tostring(squad.player_id) or nil
end

local function geography_excluded(squad)
	local faction = squad_faction(squad)
	return comma_set(ini_string("geography", "excluded_factions"))[tostring(faction or ""):lower()] == true
end

local function add_presence(level_name, faction, strength)
	if not (level_name and faction) then
		return
	end
	local level = presence_by_level[level_name] or {}
	level[faction] = math.max(0, (tonumber(level[faction]) or 0) + (tonumber(strength) or 0))
	presence_by_level[level_name] = level
end

local function remove_presence(squad_id)
	local entry = squad_id and presence_by_squad[squad_id] or nil
	if not entry then
		return
	end
	local level = presence_by_level[entry.level]
	if level and entry.faction then
		level[entry.faction] = math.max(0, (tonumber(level[entry.faction]) or 0) - (tonumber(entry.strength) or 0))
	end
	presence_by_squad[squad_id] = nil
end

local function track_presence(squad, level_name)
	local squad_id = tonumber(squad and squad.id)
	if not (squad_id and level_name) then
		return
	end
	remove_presence(squad_id)
	local faction = squad_faction(squad)
	if not faction then
		return
	end
	local strength = squad_strength(squad)
	presence_by_squad[squad_id] = { level = level_name, faction = faction, strength = strength }
	add_presence(level_name, faction, strength)
end

local function rebuild_presence(board)
	presence_by_level = {}
	presence_by_squad = {}
	for level_name, bucket in pairs(board and board.zhopa2_squads_by_level or {}) do
		for _, squad in pairs(bucket or {}) do
			track_presence(squad, level_name)
		end
	end
	presence_ready = true
end

local function ensure_presence()
	if not presence_ready then
		local board = rawget(_G, "SIMBOARD")
		if board and board.zhopa2_buckets_ready == true and type(board.zhopa2_squads_by_level) == "table" then
			rebuild_presence(board)
		end
	end
end

local function profile_name_for_faction(faction)
	if not faction then
		return nil
	end
	local cached = profile_name_cache[faction]
	if cached ~= nil then
		return cached ~= false and cached or nil
	end
	local name = ini_string("faction_profiles", faction)
	profile_name_cache[faction] = name or false
	return name
end

function M.profile_for_squad(squad)
	if cfg_bool("faction_lore_preferences_enabled", true) ~= true then
		return nil
	end
	return profile_name_for_faction(squad_faction(squad))
end

function M.profile_task_weight(squad, task)
	local profile = M.profile_for_squad(squad)
	if not profile then
		return task == "REST" and 0 or 1
	end
	local key = "task_" .. tostring(task or ""):lower()
	local value = ini_number("profile_" .. profile, key)
	if value == nil then
		return task == "REST" and 0 or 1
	end
	return math.max(0, value)
end

function M.hunt_options(squad, fallback_prey, fallback_level_mode)
	local profile = M.profile_for_squad(squad)
	if not profile then
		return { prey = fallback_prey, level_mode = fallback_level_mode }, nil
	end
	local section = "profile_" .. profile
	return {
		prey = ini_string(section, "hunt_prey") or fallback_prey,
		level_mode = ini_string(section, "hunt_level_mode") or fallback_level_mode,
	}, profile
end

function M.faction_relation(owner_faction, other_faction)
	local mod = perception()
	if mod and type(mod.faction_relation_kind) == "function" then
		local ok, relation = pcall(mod.faction_relation_kind, owner_faction, other_faction)
		if ok and relation then
			return relation
		end
	end
	return owner_faction and other_faction and owner_faction == other_faction and "ally" or "neutral"
end

function M.level_metadata(level_name)
	if type(level_name) ~= "string" or level_name == "" then
		return nil
	end
	ensure_geometry()
	if level_meta_cache[level_name] then
		return level_meta_cache[level_name]
	end
	local difficulty = ini_number("level_difficulty", level_name)
	local axis = ini_number("level_axis", level_name) or level_centers[level_name]
	if difficulty == nil and axis ~= nil then
		local sign = ini_number("geography", "north_sign") or 1
		local min_axis
		local max_axis
		for _, value in pairs(level_centers) do
			value = value * sign
			min_axis = min_axis and math.min(min_axis, value) or value
			max_axis = max_axis and math.max(max_axis, value) or value
		end
		if min_axis and max_axis and max_axis > min_axis then
			difficulty = 1 + (((axis * sign) - min_axis) / (max_axis - min_axis)) * 4
		end
	end
	local meta = { level = level_name, axis = axis, difficulty = difficulty }
	level_meta_cache[level_name] = meta
	return meta
end

function M.target_level(target)
	if target ~= nil and not (type(target) == "table" or type(target) == "userdata") then
		local target_id = tonumber(target)
		if target_id and alife_object then
			local ok, object = pcall(alife_object, target_id)
			target = ok and object or nil
		end
	end
	local mod = perception()
	if mod and type(mod.obj_level) == "function" then
		local ok, level_name = pcall(mod.obj_level, target)
		return ok and level_name or nil
	end
	return nil
end

local function geography_modifier(squad, target_level)
	if cfg_bool("geographic_balance_enabled", true) ~= true then
		return 1
	end
	if geography_excluded(squad) then
		return 1
	end
	local difficulty = M.level_metadata(target_level)
	difficulty = difficulty and difficulty.difficulty or nil
	if not difficulty then
		return 1
	end
	local delta = difficulty - squad_strength(squad)
	local penalty = ini_number("geography", "danger_step_penalty") or 0.18
	local easy_penalty = ini_number("geography", "easy_step_penalty") or 0.04
	local match_bonus = ini_number("geography", "match_bonus") or 0.10
	local floor = ini_number("geography", "minimum_multiplier") or 0.35
	local modifier = 1 + math.max(0, 1 - math.abs(delta)) * match_bonus
	if delta > 0 then
		modifier = modifier - delta * penalty
	elseif delta < 0 then
		modifier = modifier - (-delta) * easy_penalty
	end
	return math.max(floor, modifier)
end

local function presence_modifier(squad, target_level)
	if cfg_bool("faction_presence_balance_enabled", true) ~= true then
		return 1
	end
	ensure_presence()
	local snapshot = target_level and presence_by_level[target_level] or nil
	if not snapshot then
		return 1
	end
	local total = 0
	for _, strength in pairs(snapshot) do
		total = total + (tonumber(strength) or 0)
	end
	if total < (ini_number("faction_presence", "minimum_strength") or 2) then
		return 1
	end
	local faction = squad_faction(squad)
	local friendly = 0
	local hostile = 0
	for other_faction, strength in pairs(snapshot) do
		local relation = M.faction_relation(faction, other_faction)
		if relation == "ally" then
			friendly = friendly + (tonumber(strength) or 0)
		elseif relation == "enemy" then
			hostile = hostile + (tonumber(strength) or 0)
		end
	end
	local modifier = 1
	modifier = modifier + friendly * (ini_number("faction_presence", "ally_bonus_per_strength") or 0.025)
	modifier = modifier - hostile * (ini_number("faction_presence", "enemy_penalty_per_strength") or 0.035)
	local minimum = ini_number("faction_presence", "minimum_multiplier") or 0.35
	local maximum = ini_number("faction_presence", "maximum_multiplier") or 1.50
	return math.max(minimum, math.min(maximum, modifier))
end

local function lore_modifier(squad, candidate)
	if cfg_bool("faction_lore_preferences_enabled", true) ~= true then
		return 1, nil
	end
	local profile = M.profile_for_squad(squad)
	if not profile then
		return 1, nil
	end
	local section = "profile_" .. profile
	local modifier = M.profile_task_weight(squad, candidate.task)
	if candidate.task == "EXPLORE" then
		local source_level = M.target_level(squad)
		local source_meta = M.level_metadata(source_level)
		local target_meta = M.level_metadata(candidate.target_level)
		if source_meta and target_meta and source_meta.axis and target_meta.axis then
			if target_meta.axis > source_meta.axis then
				modifier = modifier * (ini_number(section, "explore_north_multiplier") or 1)
			elseif target_meta.axis < source_meta.axis then
				modifier = modifier * (ini_number(section, "explore_south_multiplier") or 1)
			end
		end
	end
	return modifier, profile
end

function M.make_candidate(squad, choice, base_weight, selection_class)
	if not (choice and choice.task and choice.target) then
		return nil
	end
	local target
	local target_id = tonumber(choice.target)
	if target_id and alife_object then
		local ok, object = pcall(alife_object, target_id)
		target = ok and object or nil
	end
	return {
		task = choice.task,
		target = choice.target,
		target_level = choice.target_level or M.target_level(target),
		base_weight = math.max(0, tonumber(base_weight) or tonumber(choice.weight) or 0),
		payload = choice,
		selection_class = selection_class or "ordinary",
	}
end

local function weighted_pick(candidates)
	local total = 0
	for i = 1, #candidates do
		total = total + (tonumber(candidates[i].final_weight) or 0)
	end
	if total <= 0 then
		return nil
	end
	local roll = math.random() * total
	local current = 0
	for i = 1, #candidates do
		current = current + (tonumber(candidates[i].final_weight) or 0)
		if roll <= current then
			return candidates[i]
		end
	end
	return candidates[#candidates]
end

function M.select_candidate(squad, candidates, context)
	if type(candidates) ~= "table" or #candidates == 0 then
		return nil, "no_candidates"
	end
	local scored = {}
	for i = 1, #candidates do
		local candidate = candidates[i]
		local base = tonumber(candidate and candidate.base_weight) or 0
		if base > 0 then
			local geography = geography_modifier(squad, candidate.target_level)
			local presence = presence_modifier(squad, candidate.target_level)
			local lore, profile = lore_modifier(squad, candidate)
			local final = base * geography * presence * lore
			if final > 0 then
				candidate.modifiers = { geography = geography, presence = presence, lore = lore }
				candidate.profile = profile
				candidate.final_weight = final
				scored[#scored + 1] = candidate
			else
				candidate.skipped_reason = "zero_scored_weight"
				debug_printf("~ ZHOPA2 task score | skipped [%s] task [%s] target [%s] level [%s] base [%.2f] geo [%.2f] presence [%.2f] lore [%.2f]", candidate.skipped_reason, tostring(candidate.task), tostring(candidate.target), tostring(candidate.target_level or "-"), base, geography, presence, lore)
			end
		else
			candidate.skipped_reason = "zero_base_weight"
			debug_printf("~ ZHOPA2 task score | skipped [%s] task [%s] target [%s]", candidate.skipped_reason, tostring(candidate and candidate.task or "-"), tostring(candidate and candidate.target or "-"))
		end
	end
	local selected = weighted_pick(scored)
	if selected then
		debug_printf("~ ZHOPA2 task score | squad [%s] task [%s] target [%s] level [%s] base [%.2f] geo [%.2f] presence [%.2f] lore [%.2f] final [%.2f] profile [%s]", tostring(squad and squad.id or "-"), tostring(selected.task), tostring(selected.target), tostring(selected.target_level or "-"), tonumber(selected.base_weight) or 0, tonumber(selected.modifiers.geography) or 1, tonumber(selected.modifiers.presence) or 1, tonumber(selected.modifiers.lore) or 1, tonumber(selected.final_weight) or 0, tostring(selected.profile or "-"))
		return selected.payload, selected
	end
	debug_printf("~ ZHOPA2 task score | squad [%s] skipped [%s] candidates [%s]", tostring(squad and squad.id or "-"), "no_positive_candidate", tostring(#candidates))
	return nil, "no_positive_candidate"
end

function M.materialize(candidate)
	return candidate and candidate.payload or candidate
end

function M.collect_trade_route_candidates(squad, opts)
	local economy = rawget(_G, "zhopa2_economy")
	if not economy and require then
		pcall(require, "zhopa2_economy")
		economy = rawget(_G, "zhopa2_economy")
	end
	if economy and type(economy.collect_trade_route_smarts) == "function" then
		return economy.collect_trade_route_smarts(squad, opts)
	end
	return {}
end

function M.allow_conditional_target(squad, task, target)
	if cfg_bool("geographic_balance_enabled", true) ~= true or (task ~= "HUNT" and task ~= "REVENGE") then
		return true
	end
	if geography_excluded(squad) then
		return true
	end
	local config = cfg()
	local mode = math.floor(tonumber(config and type(config.get_num) == "function" and config.get_num("geographic_balance_mode", 2) or 2) or 2)
	if mode <= 1 then
		return true
	end
	local meta = M.level_metadata(M.target_level(target))
	local difficulty = meta and meta.difficulty or nil
	if not difficulty then
		return true
	end
	local gap = difficulty - squad_strength(squad)
	if mode >= 3 then
		local threshold = ini_number("conditional_targets", "strict_min_gap") or 2
		if gap >= threshold then
			debug_printf("~ ZHOPA2 task score | direct_reject [strict] squad [%s] task [%s] target [%s] gap [%.2f]", tostring(squad and squad.id or "-"), tostring(task), tostring(target and target.id or "-"), gap)
			return false
		end
		return true
	end
	local threshold = ini_number("conditional_targets", "balanced_min_gap") or 3
	if gap >= threshold and math.random(100) <= (ini_number("conditional_targets", "balanced_reject_chance") or 50) then
		debug_printf("~ ZHOPA2 task score | direct_reject [balanced] squad [%s] task [%s] target [%s] gap [%.2f]", tostring(squad and squad.id or "-"), tostring(task), tostring(target and target.id or "-"), gap)
		return false
	end
	return true
end

function M.on_smart_registered(_, _)
	geometry_dirty = true
end

function M.on_smart_unregistered(_, _)
	geometry_dirty = true
end

function M.on_squad_level_changed(squad, old_level, new_level)
	if new_level then
		track_presence(squad, new_level)
	else
		remove_presence(tonumber(squad and squad.id))
	end
	presence_ready = true
end

function M.on_squad_unregistered(squad, _)
	local squad_id = tonumber(squad and squad.id)
	remove_presence(squad_id)
	if squad_id then
		strength_cache[squad_id] = nil
	end
end

function M.on_buckets_rebuilt(board)
	geometry_dirty = true
	rebuild_presence(board)
end

function M.on_game_start()
	if rawget(_G, "zhopa2_runtime_disabled") == true then
		return M.on_master_disable()
	end
	if RegisterScriptCallback then
		if UnregisterScriptCallback then
			pcall(UnregisterScriptCallback, "on_game_load", on_game_load)
		end
		pcall(RegisterScriptCallback, "on_game_load", on_game_load)
	end
	reload_ini()
	reset_runtime()
	return true
end

function M.on_master_disable()
	if UnregisterScriptCallback then
		pcall(UnregisterScriptCallback, "on_game_load", on_game_load)
	end
	reset_runtime()
	profiles_ini = nil
	return true
end

on_game_load = function()
	reset_runtime()
end

function on_game_start()
	return M.on_game_start()
end

_G.zhopa2_task_scoring = M
return M
