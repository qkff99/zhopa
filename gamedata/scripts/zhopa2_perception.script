local M = {}

local MAX_PATROL_POINTS = 4
local HUNT_BASE_SAFE_RADIUS = 50
local HUNT_BASE_SAFE_RADIUS_SQR = HUNT_BASE_SAFE_RADIUS * HUNT_BASE_SAFE_RADIUS
local HUNT_RUNTIME_CACHE_TTL_MS = 2000
M.BASE_POPULATE_PICK_TTL_MS = 2000
M.base_populate_pick_cache = {}
M.base_populate_pick_cache_cleanup_at = 0

local target_maps_cache = {}
local neighbors_cache = {}
local hunt_candidate_cache = {}
local hunt_pick_cache = {}
local hunt_cache_cleanup_at = 0
local frame_cache_key = nil
local frame_cache = {}
local NIL_VALUE = {}
local base_smarts_on_levels
local monster_player_ids = {
	["monster"] = true,
	["monster_predatory"] = true,
	["monster_predatory_day"] = true,
	["monster_predatory_night"] = true,
	["monster_vegetarian"] = true,
	["monster_zombied"] = true,
	["monster_zombied_day"] = true,
	["monster_zombied_night"] = true,
	["zombied"] = true,
}
local relation_faction_aliases = {
	duty = "dolg",
	merc = "killer",
	mutant = "monster",
	mutants = "monster",
	monster_predatory = "monster",
	monster_predatory_day = "monster",
	monster_predatory_night = "monster",
	monster_vegetarian = "monster",
	monster_special = "monster",
	monster_zombied = "zombied",
	monster_zombied_day = "zombied",
	monster_zombied_night = "zombied",
}
local cfg_require_attempted = false

local function squad_section_name(squad)
	if not squad then
		return nil
	end
	if squad.zhopa2_section_name ~= nil then
		return squad.zhopa2_section_name
	end
	if type(squad.section_name) ~= "function" then
		return nil
	end
	local ok, section = pcall(squad.section_name, squad)
	if ok and section then
		squad.zhopa2_section_name = section
		return section
	end
	return nil
end

local function section_faction(section)
	if not (section and ini_sys and ini_sys.r_string_ex) then
		return nil
	end
	local ok, faction = pcall(ini_sys.r_string_ex, ini_sys, section, "faction")
	return ok and faction or nil
end

function M.squad_player_id(squad)
	local player_id = squad and squad.player_id or nil
	if player_id == "monster" or player_id == "monster_predatory" or player_id == "monster_zombied" or player_id == nil then
		local faction = section_faction(squad_section_name(squad))
		if faction and faction ~= "" then
			return faction
		end
	end
	return player_id
end

function M.squad_relation_faction(squad)
	local player_id = M.squad_player_id(squad)
	if player_id == nil then
		return nil
	end
	local faction = tostring(player_id)
	return relation_faction_aliases[faction] or faction
end

local function cfg()
	local c = rawget(_G, "zhopa2_cfg")
	if not c and not cfg_require_attempted and require then
		cfg_require_attempted = true
		pcall(require, "zhopa2_cfg")
		c = rawget(_G, "zhopa2_cfg")
	end
	return c
end

local function now_ms()
	if time_global then
		return time_global()
	end
	return math.floor((os and os.clock and os.clock() or 0) * 1000)
end

local function cleanup_runtime_hunt_cache(now)
	now = tonumber(now) or now_ms()
	if now < hunt_cache_cleanup_at then
		return
	end
	hunt_cache_cleanup_at = now + 5000
	for key, entry in pairs(hunt_candidate_cache) do
		if not entry or (tonumber(entry.expires) or 0) <= now then
			hunt_candidate_cache[key] = nil
		end
	end
	for key, entry in pairs(hunt_pick_cache) do
		if not entry or (tonumber(entry.expires) or 0) <= now then
			hunt_pick_cache[key] = nil
		end
	end
end

function M.cleanup_base_populate_pick_cache(now)
	now = tonumber(now) or now_ms()
	if now < M.base_populate_pick_cache_cleanup_at then
		return
	end
	M.base_populate_pick_cache_cleanup_at = now + 5000
	for key, entry in pairs(M.base_populate_pick_cache) do
		if not entry or (tonumber(entry.expires) or 0) <= now then
			M.base_populate_pick_cache[key] = nil
		end
	end
end

local function current_frame_key()
	local dev
	if type(device) == "function" then
		local ok, result = pcall(device)
		dev = ok and result or nil
	elseif type(device) == "table" or type(device) == "userdata" then
		dev = device
	end
	if dev and dev.frame ~= nil then
		return tonumber(dev.frame) or tostring(dev.frame)
	end
	return now_ms()
end

local function current_frame_cache()
	local key = current_frame_key()
	if frame_cache_key ~= key then
		frame_cache_key = key
		frame_cache = {}
	end
	return frame_cache
end

local function cached_frame_value(key, build_fn)
	local cache = current_frame_cache()
	local value = cache[key]
	if value ~= nil then
		if value == NIL_VALUE then
			return nil
		end
		return value
	end
	value = build_fn()
	cache[key] = value ~= nil and value or NIL_VALUE
	return value
end

local function cached_frame_pair(key, build_fn)
	local cache = current_frame_cache()
	local value = cache[key]
	if value ~= nil then
		return value[1], value[2]
	end
	local first, second = build_fn()
	cache[key] = { first, second }
	return first, second
end

local function obj_cache_key(obj)
	if not obj then
		return "nil"
	end
	local obj_id = obj.id or obj.m_id or tostring(obj)
	return tostring(obj_id) .. "@" .. tostring(obj.m_game_vertex_id or "")
end

local function memory_mod()
	local mem = rawget(_G, "zhopa2_memory")
	if not mem and require then
		pcall(require, "zhopa2_memory")
		mem = rawget(_G, "zhopa2_memory")
	end
	return mem
end

local function index_mod()
	local idx = rawget(_G, "zhopa2_index")
	if not idx and require then
		pcall(require, "zhopa2_index")
		idx = rawget(_G, "zhopa2_index")
	end
	return idx
end

function M.is_monster_squad(squad)
	local player_id = M.squad_player_id(squad)
	return player_id ~= nil and (monster_player_ids[player_id] == true or (is_squad_monster and is_squad_monster[player_id] == true))
end

function M.mutant_cycle_active(squad)
	if not M.is_monster_squad(squad) then
		return true
	end

	local player_id = M.squad_player_id(squad)
	if player_id ~= "monster_predatory_day" and player_id ~= "monster_zombied_day"
		and player_id ~= "monster_predatory_night" and player_id ~= "monster_zombied_night"
	then
		return true
	end

	local hour = tonumber(level and level.get_time_hours and level.get_time_hours() or 12) or 12
	if player_id == "monster_predatory_day" or player_id == "monster_zombied_day" then
		return hour >= 6 and hour < 19
	end
	return hour < 6 or hour >= 19
end

local function plain_sim_stalker_squad(squad)
	if M.is_monster_squad(squad) then
		return false
	end
	local section = squad_section_name(squad)
	return type(section) == "string"
		and string.find(section, "_sim_squad_", 1, true) ~= nil
		and string.find(section, "_sim_squad_service_", 1, true) == nil
		and not section:match("_sim_squad_guard$")
		and string.find(section, "_sim_squad_dead", 1, true) == nil
end

function M.game_time()
	return game and game.get_game_time and game.get_game_time() or nil
end

function M.elapsed(start_time)
	local now = M.game_time()
	if not (now and start_time) then
		return 0
	end
	return now:diffSec(start_time)
end

function M.obj_level(obj)
	if not (obj and obj.m_game_vertex_id) then
		return nil
	end
	return cached_frame_value("obj_level|" .. obj_cache_key(obj), function()
		local gg = game_graph()
		if not (gg and gg:valid_vertex_id(obj.m_game_vertex_id)) then
			return nil
		end
		if not alife then
			return nil
		end
		local sim = alife()
		if not sim then
			return nil
		end
		return sim:level_name(gg:vertex(obj.m_game_vertex_id):level_id())
	end)
end

function M.obj_same_level(a, b)
	local a_level = M.obj_level(a)
	return a_level ~= nil and a_level == M.obj_level(b)
end

local function add_level(set, list, level_name)
	if type(level_name) ~= "string" or level_name == "" then
		return false
	end
	if set[level_name] then
		return false
	end
	set[level_name] = true
	list[#list + 1] = level_name
	return true
end

local function target_maps(level_name)
	if type(level_name) ~= "string" or level_name == "" then
		return {}
	end
	if target_maps_cache[level_name] then
		return target_maps_cache[level_name]
	end

	local out = {}
	local sim_objects = rawget(_G, "simulation_objects")
	local sim_cfg = sim_objects and sim_objects.config
	if sim_cfg and sim_cfg.section_exist and sim_cfg:section_exist(level_name) then
		out = parse_list(sim_cfg, level_name, "target_maps") or {}
	end
	target_maps_cache[level_name] = out
	return out
end

local function target_maps_has(level_name, target_level)
	local levels = target_maps(level_name)
	for i = 1, #levels do
		if levels[i] == target_level then
			return true
		end
	end
	return false
end

local function topology_neighbors(level_name)
	local topo = rawget(_G, "zhopa2_topology")
	if topo and type(topo.get_level_neighbors) == "function" then
		local ok, res = pcall(topo.get_level_neighbors, level_name)
		if ok and type(res) == "table" then
			return res
		end
	end
	return {}
end

local function topology_revision()
	local topo = rawget(_G, "zhopa2_topology")
	if topo and type(topo.get_revision) == "function" then
		local ok, res = pcall(topo.get_revision)
		if ok then
			return tonumber(res) or 0
		end
	end
	return 0
end

local function add_neighbor_sources(level_name, add_fn)
	local from_target_maps = target_maps(level_name)
	for i = 1, #from_target_maps do
		add_fn(from_target_maps[i])
	end

	local from_topology = topology_neighbors(level_name)
	for i = 1, #from_topology do
		add_fn(from_topology[i])
	end
end

local function scan_reverse_edges(target_level, add_fn)
	local sim_objects = rawget(_G, "simulation_objects")
	local sim_cfg = sim_objects and sim_objects.config
	if not (sim_cfg and sim_cfg.section_for_each and type(add_fn) == "function") then
		return
	end

	pcall(function()
		sim_cfg:section_for_each(function(section)
			if section ~= target_level and target_maps_has(section, target_level) then
				add_fn(section)
			end
			return false
		end)
	end)
end

function M.nearby_levels(level_name)
	if type(level_name) ~= "string" or level_name == "" then
		return { direct = {}, direct_list = {}, nearby = {}, nearby_list = {}, all = {}, all_list = {} }
	end
	local revision = topology_revision()
	if neighbors_cache[level_name] and neighbors_cache[level_name].topology_revision == revision then
		return neighbors_cache[level_name]
	end

	local bundle = {
		current = level_name,
		topology_revision = revision,
		direct = {},
		direct_list = {},
		nearby = {},
		nearby_list = {},
		all = {},
		all_list = {},
	}

	local function add_direct(other_level)
		if other_level ~= level_name and add_level(bundle.direct, bundle.direct_list, other_level) then
			add_level(bundle.all, bundle.all_list, other_level)
		end
	end

	local function add_nearby(other_level)
		if other_level ~= level_name and not bundle.direct[other_level] and add_level(bundle.nearby, bundle.nearby_list, other_level) then
			add_level(bundle.all, bundle.all_list, other_level)
		end
	end

	add_level(bundle.all, bundle.all_list, level_name)
	add_neighbor_sources(level_name, add_direct)
	scan_reverse_edges(level_name, add_direct)

	-- Same idea as ZHOPA BoardIndex pass2: if direct neighbors did not yield a
	-- target, their neighbors remain a valid lower-priority search pool.
	for i = 1, #bundle.direct_list do
		local direct_level = bundle.direct_list[i]
		add_neighbor_sources(direct_level, add_nearby)
		scan_reverse_edges(direct_level, add_nearby)
	end

	neighbors_cache[level_name] = bundle
	return bundle
end

local function smart_population(smart_id)
	local board_smart = SIMBOARD and SIMBOARD.smarts and SIMBOARD.smarts[smart_id]
	if not (board_smart and board_smart.squads) then
		return 0
	end

	local count = 0
	for id in pairs(board_smart.squads) do
		local squad = alife_object(id)
		if squad and squad.npc_count and squad:npc_count() > 0 then
			count = count + 1
		end
	end
	return count
end

local function has_prey_squad(squad, smart)
	local board_smart = smart and SIMBOARD and SIMBOARD.smarts and SIMBOARD.smarts[smart.id]
	if not (board_smart and board_smart.squads) then
		return false
	end

	for id in pairs(board_smart.squads) do
		if id ~= squad.id then
			local other = alife_object(id)
			if other and not M.is_monster_squad(other) then
				return true
			end
		end
	end
	return false
end

local function smart_is_base(smart)
	local bases = rawget(_G, "zhopa2_bases")
	if bases then return bases.is_base(smart) end
	if not smart then
		return false
	end
	local props = smart.props or nil
	if props and props.base and props.base > 0 then
		return true
	end
	local sim_objects = rawget(_G, "simulation_objects")
	if sim_objects and sim_objects.base_smarts then
		local ok, smart_name = pcall(function()
			return smart:name()
		end)
		return ok and sim_objects.base_smarts[smart_name] == true
	end
	return false
end

local function base_smarts_on_level(level_name)
	if type(level_name) ~= "string" or level_name == "" then
		return {}
	end

	return cached_frame_value("base_smarts_on_level|" .. level_name, function()
		local out = {}
		local indexed = base_smarts_on_levels({ level_name })
		for i = 1, #indexed do
			local smart = indexed[i]
			if smart and smart_is_base(smart) then
				out[#out + 1] = smart.id
			end
		end
		return out
	end) or {}
end

local function distance_to_sqr(a, b)
	if not (a and b and a.position and b.position) then
		return nil
	end
	local ok, dist_sqr = pcall(function()
		return a.position:distance_to_sqr(b.position)
	end)
	if ok and tonumber(dist_sqr) then
		return tonumber(dist_sqr)
	end
	local ok_dist, dist = pcall(function()
		return a.position:distance_to(b.position)
	end)
	dist = ok_dist and tonumber(dist) or nil
	return dist and dist * dist or nil
end

local function target_near_base_smart(target, target_level)
	if not target then
		return false
	end
	return cached_frame_value("near_base|" .. obj_cache_key(target) .. "|" .. tostring(target_level or ""), function()
		local target_smart = target.smart_id and alife_object(target.smart_id) or nil
		if smart_is_base(target_smart) then
			return true
		end
		if not (target and target_level and target.position) then
			return false
		end

		local base_ids = base_smarts_on_level(target_level)
		for i = 1, #base_ids do
			local smart = alife_object(base_ids[i])
			local dist_sqr = distance_to_sqr(target, smart)
			if dist_sqr and dist_sqr <= HUNT_BASE_SAFE_RADIUS_SQR then
				return true
			end
		end
		return false
	end) == true
end

local function smart_kind_ok(squad, smart, kind)
	if not kind then
		return true
	end

	local props = smart and smart.props or nil
	if kind == "base" then
		return smart_is_base(smart)
	end
	if not props then
		return false
	end

	if kind == "rest" then
		if smart_is_base(smart) then
			return true
		end
		return (props.all_stalker and props.all_stalker > 0) or (props.all and props.all > 0) or (props.territory and props.territory > 0)
	elseif kind == "resource" then
		return props.resource and props.resource > 0
	elseif kind == "surge" then
		return props.surge and props.surge > 0
	elseif kind == "mutant" then
		return (props.lair and props.lair > 0) or (props.territory and props.territory > 0) or (props.all_monster and props.all_monster > 0) or (props.monster and props.monster > 0)
	elseif kind == "populate" then
		return true
	end
	return true
end

local function vanilla_nearby(squad, smart)
	local sim_objects = rawget(_G, "simulation_objects")
	if sim_objects and sim_objects.is_on_the_nearby_level then
		local ok, res = pcall(sim_objects.is_on_the_nearby_level, squad, smart)
		return ok and res == true
	end
	return false
end

local function level_mode_ok(mode, current_level, target_level, neighbors, squad, smart)
	if not target_level then
		return false
	end
	if mode == "same" then
		return target_level == current_level
	end
	if mode == "any" then
		return true
	end

	neighbors = neighbors or M.nearby_levels(current_level)
	local direct = neighbors.direct or {}
	local nearby = neighbors.nearby or {}
	local is_vanilla_nearby = (mode == "nearby" or mode == "current_or_nearby") and vanilla_nearby(squad, smart) or false

	if mode == "neighbor" then
		return target_level ~= current_level and direct[target_level] == true
	elseif mode == "nearby" then
		return target_level ~= current_level and (nearby[target_level] == true or is_vanilla_nearby)
	elseif mode == "current_or_neighbor" then
		return target_level == current_level or direct[target_level] == true
	elseif mode == "current_or_nearby" then
		return target_level == current_level or direct[target_level] == true or nearby[target_level] == true or is_vanilla_nearby
	end
	return true
end

function M.level_names_for_mode(current_level, mode, neighbors)
	local out = {}
	local seen = {}
	local function add(level_name)
		add_level(seen, out, level_name)
	end
	mode = mode or "current_or_nearby"

	if mode == "same" then
		add(current_level)
	elseif mode == "neighbor" then
		neighbors = neighbors or M.nearby_levels(current_level)
		for i = 1, #(neighbors.direct_list or {}) do
			add(neighbors.direct_list[i])
		end
	elseif mode == "nearby" then
		neighbors = neighbors or M.nearby_levels(current_level)
		for i = 1, #(neighbors.direct_list or {}) do
			add(neighbors.direct_list[i])
		end
		for i = 1, #(neighbors.nearby_list or {}) do
			add(neighbors.nearby_list[i])
		end
	elseif mode == "current_or_neighbor" then
		add(current_level)
		neighbors = neighbors or M.nearby_levels(current_level)
		for i = 1, #(neighbors.direct_list or {}) do
			add(neighbors.direct_list[i])
		end
	elseif mode == "current_or_nearby" then
		add(current_level)
		neighbors = neighbors or M.nearby_levels(current_level)
		for i = 1, #(neighbors.direct_list or {}) do
			add(neighbors.direct_list[i])
		end
		for i = 1, #(neighbors.nearby_list or {}) do
			add(neighbors.nearby_list[i])
		end
	else
		add(current_level)
		neighbors = neighbors or M.nearby_levels(current_level)
		for i = 1, #(neighbors.all_list or {}) do
			add(neighbors.all_list[i])
		end
	end
	return out
end

local function mode_needs_neighbors(mode)
	mode = mode or "current_or_nearby"
	return mode ~= "same" and mode ~= "any"
end

local function ensure_option_neighbors(options)
	if options and mode_needs_neighbors(options.level_mode) then
		options.neighbors = options.neighbors or M.nearby_levels(options.current_level)
	end
	return options and options.neighbors or nil
end

local function index_squads_on_levels(levels)
	local idx = index_mod()
	if idx and type(idx.squads_on_levels) == "function" then
		return idx.squads_on_levels(levels)
	end
	return {}
end

local function index_smarts_on_levels(levels, smart_kind)
	local idx = index_mod()
	if idx and type(idx.smarts_on_levels) == "function" then
		return idx.smarts_on_levels(levels, nil, smart_kind)
	end
	return {}
end

base_smarts_on_levels = function(levels)
	local idx = index_mod()
	if idx and type(idx.base_smarts_on_levels) == "function" then
		return idx.base_smarts_on_levels(levels)
	end
	return {}
end

local function levels_for_options(options)
	options = options or {}
	if type(options.candidate_levels) == "table" then return options.candidate_levels end
	local current_level = options.current_level or nil
	local mode = options.level_mode or "current_or_nearby"
	local neighbors = options.neighbors or (mode_needs_neighbors(mode) and M.nearby_levels(current_level) or nil)
	return M.level_names_for_mode(current_level, mode, neighbors)
end

local function list_key(list)
	if not list then
		return ""
	end
	local out = {}
	for i = 1, #list do
		out[i] = tostring(list[i])
	end
	table.sort(out)
	return table.concat(out, ",")
end

local function bool_key(value)
	return value == true and "1" or "0"
end

local function smart_options_signature(squad, options, levels)
	local tostr = tostring
	return table.concat({
		tostr(squad and squad.id or ""),
		tostr(squad and squad.smart_id or ""),
		tostr(options.level_mode or "current_or_nearby"),
		tostr(options.current_level or ""),
		list_key(levels),
		tostr(options.kind or ""),
		bool_key(options.safe_rest),
		bool_key(options.populate),
		bool_key(options.has_prey),
		bool_key(options.ignore_population),
		bool_key(options.skip_target_precondition),
		bool_key(options.skip_props),
		bool_key(options.skip_prior),
		bool_key(options.exclude_current),
		bool_key(options.base_populate_level_priority),
		bool_key(options.service_roam),
	}, "|")
end

local function hunt_options_signature(squad, options, levels)
	local tostr = tostring
	return table.concat({
		tostr(squad and squad.id or ""),
		tostr(squad and squad.smart_id or ""),
		tostr(options.level_mode or "current_or_nearby"),
		tostr(options.current_level or ""),
		list_key(levels),
		tostr(options.prey or ""),
		bool_key(options.ignore_recent),
		bool_key(options.allow_recent_fallback),
	}, "|")
end

local function squad_npc_count(squad)
	if not (squad and type(squad.npc_count) == "function") then
		return 0
	end
	local ok, count = pcall(squad.npc_count, squad)
	return ok and (tonumber(count) or 0) or 0
end

local function squad_member_registered_at_smart(smart, squad)
	if not (smart and smart.npc_info and squad and type(squad.squad_members) == "function") then
		return false
	end
	local ok, found = pcall(function()
		for member in squad:squad_members() do
			local id = member and member.id
			if id and smart.npc_info[id] then
				return true
			end
		end
		return false
	end)
	return ok and found == true
end

local function squad_member_id_set(squad)
	local out = {}
	if not (squad and type(squad.squad_members) == "function") then
		return out
	end
	pcall(function()
		for member in squad:squad_members() do
			if member and member.id then
				out[member.id] = true
			end
		end
	end)
	return out
end

function M.active_actor_task_targets()
	return cached_frame_value("active_actor_task_targets", function()
		local manager = rawget(_G, "task_manager")
		local actor = db and db.actor
		if not (actor and manager and type(manager.get_task_manager) == "function") then return nil end
		local ok, tm = pcall(manager.get_task_manager)
		if not (ok and tm and type(tm.task_info) == "table") then return nil end
		local targets = { ids = {}, areas = {} }
		local function mark(id)
			id = tonumber(id)
			if not id or id <= 0 or id >= 65535 then return end
			targets.ids[id] = true
		end
		local axr = rawget(_G, "axr_task_manager")
		for id, task in pairs(tm.task_info) do
			if task and (task.status == "normal" or task.status == "selected")
				and task.forced_status ~= "fail" and task.forced_status ~= "complete" and not task.cancelled_by_actor
			then
				mark(task.current_target)
				mark(axr and axr.bounties_by_id and axr.bounties_by_id[id])
				local read, data = false, nil
				if type(load_var) == "function" then read, data = pcall(load_var, actor, id) end
				if read and type(data) == "table" then
					mark(data.squad_id)
					mark(data.target_squad_id)
					mark(data.target_id)
					mark(data.spy_id)
					if task.target_functor == "top_10_task_target_functor" then
						for i = 1, 10 do mark(data[i]) end
					end
				end
				local area = { smarts = {}, enemies = true }
				if task.target_functor == "assault_task_target_functor" or task.target_functor == "smart_control_task_target_functor" then
					local smart_id = tonumber(task.current_target)
					if SIMBOARD and SIMBOARD.smarts and SIMBOARD.smarts[smart_id] then area.smarts[smart_id] = true end
					area.enemies = type(data) == "table" and data.is_enemy == true
				end
				if task.target_functor == "smart_control_task_target_functor" and type(parse_list) == "function" then
					local parsed, names = pcall(parse_list, manager.task_ini, id, "status_functor_smarts")
					if parsed and type(names) == "table" then
						for _, name in ipairs(names) do
							local smart = SIMBOARD and SIMBOARD.smarts_by_names and SIMBOARD.smarts_by_names[name]
							if smart then area.smarts[smart.id] = true end
						end
					end
				elseif task.target_functor == "dominance_task_target_functor" and manager.task_ini then
					local read_level, name = pcall(function() return manager.task_ini:r_string_ex(id, "status_functor_level") end)
					if read_level and name then area.level = name end
				end
				if (area.level or next(area.smarts)) and type(parse_list) == "function" then
					local parsed, factions = pcall(parse_list, manager.task_ini, id, "status_functor_params")
					if parsed and type(factions) == "table" and #factions > 0 then
						area.factions = factions
						targets.areas[#targets.areas + 1] = area
					end
				end
			end
		end
		return targets
	end)
end

function M.quest_protected_squad(squad)
	if not (squad and squad.id) then
		return false
	end

	local combat = rawget(_G, "sim_offline_combat")
	local reserved = combat and type(combat.task_squads) == "table" and combat.task_squads[squad.id]
	local targets = M.active_actor_task_targets()
	if targets then
		if targets.ids[squad.id] then return true, "active_actor_task" end
		if reserved then
			for _, area in ipairs(targets.areas) do
				if area.smarts[squad.current_target_id] or (area.level and area.level == M.obj_level(squad)) then
					local common_enemy = not area.enemies
					for _, faction in ipairs(area.factions) do
						if area.enemies and faction == squad.player_id then return true, "active_actor_task" end
						if not area.enemies then
							local relations = rawget(_G, "game_relations")
							local ok, hostile = false, false
							if relations and type(relations.is_factions_enemies) == "function" then
								ok, hostile = pcall(relations.is_factions_enemies, squad.player_id, faction)
							end
							common_enemy = common_enemy and ok and hostile == true
						end
					end
					if common_enemy then return true, "active_actor_task" end
				end
			end
		end
	elseif reserved then
		-- Do not release a saved quest target while the task manager is still loading.
		return true, "actor_tasks_pending"
	end
	return cached_frame_pair("quest_protected|" .. obj_cache_key(squad), function()
		if get_object_story_id and get_object_story_id(squad.id) then
			return true, "squad_story"
		end
		if squad.death_condlist ~= nil then
			return true, "death_condlist"
		end

		local member_ids = squad_member_id_set(squad)
		local hostages = axr_task_manager and axr_task_manager.hostages_by_id or nil
		for member_id in pairs(member_ids) do
			if targets and targets.ids[member_id] then return true, "active_actor_task" end
			if get_object_story_id and get_object_story_id(member_id) then
				return true, "member_story"
			end
			if hostages and hostages[member_id] then
				return true, "hostage"
			end
		end

		local bounties = not targets and axr_task_manager and axr_task_manager.bounties_by_id or nil
		for _, member_id in pairs(bounties or {}) do
			local bounty_id = tonumber(member_id) or member_id
			if member_ids[bounty_id] then
				return true, "bounty"
			end
		end
		return false
	end)
end

local function is_online_offline_group(squad)
	if not (squad and type(squad.clsid) == "function" and clsid) then
		return false
	end
	local ok, class_id = pcall(squad.clsid, squad)
	return ok and class_id == clsid.online_offline_group_s
end

local function is_zhopa2_managed_scripted_target(squad)
	return squad
		and squad.zhopa2_task ~= nil
		and squad.zhopa2_target ~= nil
		and squad.scripted_target ~= nil
		and tostring(squad.scripted_target) == tostring(squad.zhopa2_target)
end

local function is_common_sim_squad(target)
	if not target or (target.common ~= true and plain_sim_stalker_squad(target) ~= true) then
		return false
	end
	if target.random_targets or target.action_condlist then
		return false
	end
	if target.scripted_target and not is_zhopa2_managed_scripted_target(target) then
		return false
	end
	return true
end

local function is_blacklisted_for_hunt(squad, level_name, smart)
	local c = cfg()
	if not c then
		return false
	end
	if type(c.is_level_blacklisted_for_squad) == "function" and c.is_level_blacklisted_for_squad(squad, level_name) then
		return true
	end
	if smart and type(c.is_smart_blacklisted_for_squad) == "function" and c.is_smart_blacklisted_for_squad(squad, smart, level_name) then
		return true
	end
	return false
end

local function safe_zone_squad(squad)
	return squad and xr_combat_ignore and xr_combat_ignore.safe_zone_npcs and xr_combat_ignore.safe_zone_npcs[squad.id] == true
end

local function hunt_target_profile(target)
	return cached_frame_value("hunt_target_profile|" .. obj_cache_key(target), function()
		local profile = { ok = false }
		if not (target and target.id and SIMBOARD and SIMBOARD.squads and SIMBOARD.squads[target.id]) then
			return profile
		end
		if not is_common_sim_squad(target) then
			return profile
		end
		if M.quest_protected_squad(target) then
			return profile
		end
		if M.is_monster_squad(target) and not M.mutant_cycle_active(target) then
			return profile
		end
		if target.disabled or not is_online_offline_group(target) then
			return profile
		end
		profile.npc_count = squad_npc_count(target)
		if profile.npc_count <= 0 then
			return profile
		end
		if safe_zone_squad(target) then
			return profile
		end
		if get_object_story_id and get_object_story_id(target.id) then
			return profile
		end
		if axr_companions and axr_companions.companion_squads and axr_companions.companion_squads[target.id] then
			return profile
		end

		profile.level = M.obj_level(target)
		if not profile.level then
			return profile
		end
		profile.is_monster = M.is_monster_squad(target)
		profile.faction = M.squad_relation_faction(target)
		profile.smart = target.smart_id and alife_object and alife_object(target.smart_id) or nil
		profile.ok = true
		return profile
	end)
end

local function squad_targets_smart(other, smart)
	local tonum = tonumber
	if not (other and smart and smart.id) then
		return false
	end
	local smart_id = tonum(smart.id)
	return tonum(other.smart_id) == smart_id
		or tonum(other.assigned_target_id) == smart_id
		or tonum(other.current_target_id) == smart_id
		or tonum(other.zhopa2_target) == smart_id
		or tonum(other.scripted_target) == smart_id
end

local function squad_target_smart_id(other)
	local tonum = tonumber
	return other and (
		tonum(other.zhopa2_target)
		or tonum(other.assigned_target_id)
		or tonum(other.current_target_id)
		or tonum(other.smart_id)
	) or nil
end

local function squad_near_smart(other, smart)
	if not (other and smart and other.position and smart.position) then
		return false
	end
	if M.obj_level(other) ~= M.obj_level(smart) then
		return false
	end
	local radius = tonumber(smart.arrive_dist) or 0
	if radius <= 0 then
		radius = 25
	end
	local ok, dist_sqr = pcall(function()
		return other.position:distance_to_sqr(smart.position)
	end)
	dist_sqr = ok and tonumber(dist_sqr) or nil
	return dist_sqr and dist_sqr <= radius * radius or false
end

local function factions_hostile(faction, target_faction)
	if not (faction and target_faction) then
		return false
	end
	if faction == target_faction then
		return false
	end
	if not game_relations then
		return false
	end

	return cached_frame_value("factions_hostile|" .. tostring(faction) .. "|" .. tostring(target_faction), function()
		if type(game_relations.is_factions_enemies) == "function" then
			local ok, hostile = pcall(game_relations.is_factions_enemies, faction, target_faction)
			if ok and hostile == true then
				return true
			end
		end
		if type(game_relations.get_factions_community) == "function" then
			local ok, value = pcall(game_relations.get_factions_community, faction, target_faction)
			value = ok and tonumber(value) or nil
			if value and value <= -1000 then
				return true
			end
		end
		return false
	end) == true
end

function M.squad_relation_hostile(squad, target)
	return squad and target and factions_hostile(M.squad_relation_faction(squad), M.squad_relation_faction(target)) or false
end

function M.faction_relation_kind(owner_faction, other_faction)
	owner_faction = owner_faction and (relation_faction_aliases[tostring(owner_faction)] or tostring(owner_faction)) or nil
	other_faction = other_faction and (relation_faction_aliases[tostring(other_faction)] or tostring(other_faction)) or nil
	if not (owner_faction and other_faction) then
		return "neutral"
	end
	if owner_faction == other_faction then
		return "ally"
	end
	if factions_hostile(owner_faction, other_faction) then
		return "enemy"
	end
	if game_relations and type(game_relations.is_factions_friends) == "function" then
		local ok, friendly = pcall(game_relations.is_factions_friends, owner_faction, other_faction)
		if ok and friendly == true then
			return "ally"
		end
	end
	return "neutral"
end

local function faction_relation_rank(faction, owner)
	if not (faction and owner) then
		return 4
	end
	return cached_frame_value("faction_relation_rank|" .. tostring(faction) .. "|" .. tostring(owner), function()
		if faction == owner then
			return 1
		end
		if factions_hostile(faction, owner) then
			return nil
		end
		if game_relations and type(game_relations.is_factions_friends) == "function" then
			local ok, friendly = pcall(game_relations.is_factions_friends, faction, owner)
			if ok and friendly == true then
				return 2
			end
		end
		if game_relations and type(game_relations.get_factions_community) == "function" then
			local ok, value = pcall(game_relations.get_factions_community, faction, owner)
			value = ok and tonumber(value) or nil
			if value and value > 500 then
				return 2
			end
		end
		return 3
	end)
end

local function hostile_squad_at_smart(squad, other, smart)
	return other
		and other.id ~= squad.id
		and M.squad_relation_hostile(squad, other)
		and (squad_targets_smart(other, smart) or squad_near_smart(other, smart))
end

local targeted_stalker_squads_on_levels

local function smart_has_hostile_squad(squad, smart)
	local board_smart = smart and SIMBOARD and SIMBOARD.smarts and SIMBOARD.smarts[smart.id] or nil
	if board_smart and board_smart.squads then
		for id in pairs(board_smart.squads) do
			local other = id ~= squad.id and alife_object(id) or nil
			if other and M.squad_relation_hostile(squad, other) then
				return true
			end
		end
	end

	local target_level = M.obj_level(smart)
	if targeted_stalker_squads_on_levels then
		local targets = targeted_stalker_squads_on_levels({ target_level })
		local target_squads = targets[tonumber(smart.id) or smart.id]
		for i = 1, #(target_squads or {}) do
			if hostile_squad_at_smart(squad, target_squads[i], smart) then
				return true
			end
		end
		return false
	end

	local indexed = index_squads_on_levels({ target_level })
	for i = 1, #indexed do
		if hostile_squad_at_smart(squad, indexed[i], smart) then
			return true
		end
	end
	return false
end

local function base_camping_squad_at_smart(squad, other, smart)
	return other
		and smart
		and other.id ~= squad.id
		and other.zhopa2_task == "BASE_CAMPING"
		and squad_npc_count(other) > 0
		and not M.is_monster_squad(other)
		and (tonumber(other.zhopa2_target) == tonumber(smart.id) or squad_targets_smart(other, smart) or squad_near_smart(other, smart))
end

local function base_camping_target_candidates_on_levels(levels, current_level)
	local scan_seen = {}
	local scan_levels = {}
	for i = 1, #levels do
		add_level(scan_seen, scan_levels, levels[i])
	end
	add_level(scan_seen, scan_levels, current_level)

	return cached_frame_value("base_populate_target_candidates|" .. list_key(scan_levels), function()
		local idx = index_mod()
		if idx and type(idx.base_camping_target_smarts_on_levels) == "function" then
			return idx.base_camping_target_smarts_on_levels(scan_levels) or {}
		end

		local out = {}
		local seen_targets = {}
		local indexed = index_squads_on_levels(scan_levels)
		for i = 1, #indexed do
			local other = indexed[i]
			if other
				and other.zhopa2_task == "BASE_CAMPING"
				and squad_npc_count(other) > 0
				and not M.is_monster_squad(other)
			then
				local target_id = squad_target_smart_id(other)
				if target_id and not seen_targets[target_id] then
					local smart = alife_object(target_id)
					if smart then
						seen_targets[target_id] = true
						out[#out + 1] = smart
					end
				end
			end
		end
		return out
	end) or {}
end

local function base_camping_populate_level_rank(squad, smart, options)
	if not (options and options.base_populate_level_priority == true) then
		return 1
	end
	local current_level = options.current_level or M.obj_level(squad)
	local target_level = M.obj_level(smart)
	if target_level == current_level then
		return 1
	end
	local neighbors = options.neighbors or M.nearby_levels(current_level)
	if neighbors.direct and neighbors.direct[target_level] == true then
		return 2
	end
	return 3
end

local function base_camping_populate_candidates(squad, opts)
	local options = opts or {}
	options.current_level = options.current_level or M.obj_level(squad)
	ensure_option_neighbors(options)
	local levels = levels_for_options(options)
	local signature = smart_options_signature(squad, options, levels)
	local validation_options = options
	if options.base_populate_level_priority == true then
		validation_options = {}
		for k, v in pairs(options) do
			validation_options[k] = v
		end
		validation_options.level_mode = "any"
	end

	return cached_frame_value("base_populate_candidates|" .. signature, function()
		local candidates = base_camping_target_candidates_on_levels(levels, options.current_level)
		if options.base_populate_level_priority == true then
			local ranked = { {}, {}, {} }
			for i = 1, #candidates do
				local smart = candidates[i]
				local rank = base_camping_populate_level_rank(squad, smart, options)
				ranked[rank] = ranked[rank] or {}
				ranked[rank][#ranked[rank] + 1] = smart
			end
			for rank = 1, 3 do
				local out = {}
				local list = ranked[rank] or {}
				for i = 1, #list do
					local smart = list[i]
					if M.valid_smart(squad, smart, validation_options) then
						out[#out + 1] = smart
					end
				end
				if #out > 0 then
					return out
				end
			end
			return {}
		end

		local out = {}
		for i = 1, #candidates do
			local smart = candidates[i]
			if M.valid_smart(squad, smart, validation_options) then
				out[#out + 1] = smart
			end
		end
		return out
	end) or {}
end

local function base_camping_target_map(squad, candidates)
	local ids = {}
	local candidate_by_id = {}
	local levels = {}
	for i = 1, #candidates do
		local smart = candidates[i]
		if smart and smart.id then
			local smart_id = tonumber(smart.id) or smart.id
			ids[#ids + 1] = tostring(smart_id)
			candidate_by_id[smart_id] = true
			local level_name = M.obj_level(smart)
			if level_name then
				levels[level_name] = true
			end
		end
	end

	table.sort(ids)
	local cache_key = "base_camping_target_map|" .. tostring(squad and squad.id or "") .. "|" .. table.concat(ids, ",")
	return cached_frame_value(cache_key, function()
		local targets = {}
		for i = 1, #candidates do
			local smart = candidates[i]
			local board_smart = smart and SIMBOARD and SIMBOARD.smarts and SIMBOARD.smarts[smart.id] or nil
			if board_smart and board_smart.squads then
				for id in pairs(board_smart.squads) do
					local other = id ~= squad.id and alife_object(id) or nil
					if base_camping_squad_at_smart(squad, other, smart) then
						targets[tonumber(smart.id) or smart.id] = true
					end
				end
			end
		end

		local indexed = index_squads_on_levels(levels)
		for i = 1, #indexed do
			local other = indexed[i]
			local target_id = squad_target_smart_id(other)
			if other
				and other.id ~= squad.id
				and other.zhopa2_task == "BASE_CAMPING"
				and squad_npc_count(other) > 0
				and not M.is_monster_squad(other)
				and target_id
				and candidate_by_id[target_id]
			then
				targets[target_id] = true
			end
		end
		return targets
	end) or {}
end

local function smart_owner_relation_rank(squad, smart)
	local idx = index_mod()
	local ownership = idx and idx.base_ownership and idx.base_ownership(smart) or nil
	if not ownership and idx and idx.update_base_ownership then
		ownership = idx.update_base_ownership(smart)
	end
	if not ownership then
		return 4
	end
	if ownership.state == "unstable" then
		return nil
	end
	if ownership.state == "owned" then
		return faction_relation_rank(M.squad_relation_faction(squad), relation_faction_aliases[tostring(ownership.owner)] or ownership.owner)
	end
	return 4
end

local function nonexclusive_job_capacity(jobs)
	if not jobs then
		return nil
	end
	local count = 0
	for i = 1, #jobs do
		if not jobs[i].exclusive then
			count = count + 1
		end
	end
	return count > 0 and count or nil
end

local function smart_stalker_job_capacity(smart)
	if not smart then
		return nil
	end
	local cached = tonumber(smart.zhopa2_job_capacity_stalker)
	if cached and cached > 0 then
		return cached
	end
	return nonexclusive_job_capacity(smart.stalker_jobs)
end

local function occupied_stalker_jobs(smart, ignore_squad)
	if not (smart and smart.stalker_jobs and smart.npc_by_job_section) then
		return 0
	end
	local ignore_ids
	local function ignored(npc_id)
		if not (npc_id and ignore_squad) then
			return false
		end
		if not ignore_ids then
			ignore_ids = squad_member_id_set(ignore_squad)
		end
		return ignore_ids[npc_id] == true
	end

	local sections = smart.zhopa2_stalker_job_nonexclusive_sections
	if sections then
		local count = 0
		for section, npc_id in pairs(smart.npc_by_job_section) do
			if npc_id and sections[section] and not ignored(npc_id) then
				count = count + 1
			end
		end
		return count
	end

	local count = 0
	for i = 1, #smart.stalker_jobs do
		local job = smart.stalker_jobs[i]
		local npc_id = job and smart.npc_by_job_section[job.section] or nil
		if job and not job.exclusive and npc_id and not ignored(npc_id) then
			count = count + 1
		end
	end
	return count
end

targeted_stalker_squads_on_levels = function(levels)
	return cached_frame_value("targeted_stalker_squads|" .. list_key(levels), function()
		local out = {}
		local indexed = index_squads_on_levels(levels)
		for i = 1, #indexed do
			local other = indexed[i]
			if other and not M.is_monster_squad(other) then
				local target_id = squad_target_smart_id(other)
				if target_id and squad_npc_count(other) > 0 then
					out[target_id] = out[target_id] or {}
					out[target_id][#out[target_id] + 1] = other
				end
			end
		end
		return out
	end) or {}
end

local function smart_incoming_stalker_npc_load(squad, smart)
	if not (squad and smart and smart.id) then
		return 0
	end
	return cached_frame_value("incoming_stalker_load|" .. tostring(squad.id) .. "|" .. tostring(smart.id), function()
		local seen = {}
		local count = 0
		local function add_other(other)
			if not (other and other.id and other.id ~= squad.id and not seen[other.id]) then
				return
			end
			if M.is_monster_squad(other) or M.squad_relation_hostile(squad, other) then
				return
			end
			if not (squad_targets_smart(other, smart) or squad_near_smart(other, smart)) then
				return
			end
			if squad_member_registered_at_smart(smart, other) then
				return
			end
			local npc_count = squad_npc_count(other)
			if npc_count <= 0 then
				return
			end
			seen[other.id] = true
			count = count + npc_count
		end

		local board_smart = SIMBOARD and SIMBOARD.smarts and SIMBOARD.smarts[smart.id] or nil
		if board_smart and board_smart.squads then
			for id in pairs(board_smart.squads) do
				add_other(alife_object(id))
			end
		end

		local target_level = M.obj_level(smart)
		local current_level = M.obj_level(squad)
		local levels = { target_level }
		if current_level and current_level ~= target_level then
			levels[#levels + 1] = current_level
		end
		local targets = targeted_stalker_squads_on_levels(levels)
		local target_squads = targets[tonumber(smart.id) or smart.id]
		for i = 1, #(target_squads or {}) do
			add_other(target_squads[i])
		end
		return count
	end) or 0
end

function M.smart_stalker_free_job_slots(squad, smart)
	if not (squad and smart and smart.id) then
		return nil
	end
	return cached_frame_value("free_stalker_jobs|" .. tostring(squad.id) .. "|" .. tostring(smart.id), function()
		local capacity = smart_stalker_job_capacity(smart)
		if not capacity then
			return nil
		end
		local used = occupied_stalker_jobs(smart, squad) + smart_incoming_stalker_npc_load(squad, smart)
		local free = capacity - used
		return free > 0 and free or 0
	end)
end

function M.smart_settlement_capacity(squad, smart, shared_seen)
	if not (squad and smart and smart.id) then return nil end
	local capacity = tonumber(smart.max_population)
	if not capacity then return nil end
	capacity = math.max(0, math.floor(capacity))
	local seen, used = shared_seen or {}, 0
	local function count(other)
		if not other or not other.id or other.id == squad.id or seen[other.id] then return end
		if M.is_monster_squad(other) or squad_npc_count(other) <= 0 or other.zhopa2_service_filler == true or other.zhopa2_guard_filler == true then return end
		-- Scripted residents have their own jobs, outside the roaming squad quota.
		if other.action_condlist or other.random_targets or (get_object_story_id and get_object_story_id(other.id)) then return end
		if other.scripted_target and not (other.zhopa2_task and other.zhopa2_target
			and tostring(other.scripted_target) == tostring(other.zhopa2_target)) then return end
		local section = squad_section_name(other) or ""
		local service_role = section:match("_sim_squad_([%a]+)$")
		if section:find("_sim_squad_service_", 1, true) or service_role == "guard" or service_role == "trader"
			or service_role == "barman" or service_role == "mechanic" or service_role == "medic" then return end
		local resident = squad_near_smart(other, smart)
		if resident or (squad_targets_smart(other, smart) and not M.squad_relation_hostile(squad, other)) then seen[other.id] = true; used = used + 1 end
	end
	local node = SIMBOARD and SIMBOARD.smarts and SIMBOARD.smarts[smart.id]
	for id in pairs(node and node.squads or {}) do count(alife_object and alife_object(id)) end
	local levels = {M.obj_level(smart)}
	local source_level = M.obj_level(squad)
	if source_level and source_level ~= levels[1] then levels[#levels + 1] = source_level end
	local targets = targeted_stalker_squads_on_levels(levels)
	for _, other in ipairs(targets[tonumber(smart.id) or smart.id] or {}) do count(other) end
	return capacity, math.max(0, capacity - used), squad_near_smart(squad, smart)
end

function M.service_base_roam_weight(squad, smart)
	if not (squad and smart and smart.id) or M.is_monster_squad(squad) then return nil end
	local svc = rawget(_G, "zhopa2_service_fillers")
	if not (svc and type(svc.is_service_base) == "function" and svc.is_service_base(smart)) then return nil end
	local sim_objects = rawget(_G, "simulation_objects")
	if smart.disabled or smart.respawn_only_smart
		or (sim_objects and sim_objects.available_by_id and sim_objects.available_by_id[smart.id] == false) then return 0 end
	return cached_frame_value("service_roam|" .. tostring(squad.id) .. "|" .. tostring(smart.id), function()
		if squad_npc_count(squad) <= 0 then return 0 end
		local capacity, free = M.smart_settlement_capacity(squad, smart)
		if not capacity then return nil end
		if capacity <= 0 or free < 1 then return 0 end
		local idx = index_mod()
		local own = idx and idx.base_ownership and idx.base_ownership(smart)
		if idx and idx.update_base_ownership and (not own or now_ms() - (tonumber(own.updated) or 0) >= 1000) then
			own = idx.update_base_ownership(smart)
		end
		if not own or own.state == "unstable" then return 0 end
		if own.state == "owned" and not faction_relation_rank(M.squad_relation_faction(squad),
			relation_faction_aliases[tostring(own.owner)] or own.owner) then return 0 end
        local bases = rawget(_G, "zhopa2_bases")
        if bases then
            local totals = cached_frame_value("base_capacity|" .. tostring(squad.id) .. "|" .. bases.key(smart), function()
                local total_capacity, total_used, seen = 0, 0, {}
                for _, part in ipairs(bases.members(smart)) do
                    if not part.disabled and not part.respawn_only_smart
                        and not (sim_objects and sim_objects.available_by_id and sim_objects.available_by_id[part.id] == false) then
                        local cap, spare = M.smart_settlement_capacity(squad, part, seen)
                        if cap then total_capacity = total_capacity + cap; total_used = total_used + cap - spare end
                    end
                end
                return {capacity=total_capacity, free=math.max(0,total_capacity-total_used)}
            end)
            capacity, free = totals.capacity, totals.free
            if capacity <= 0 then return 0 end
        end
		-- Empty = x4; quarter occupied = x2.5; half occupied or more = ordinary weight.
		return 1 + 3 * math.max(0, math.min(1, 2 * free / capacity - 1))
	end)
end

function M.pick_roam_smart(squad, candidates)
	local selected, total = nil, 0
	local bases = not M.is_monster_squad(squad) and rawget(_G, "zhopa2_bases")
	local weighted, counts = {}, {}
	for i = 1, #candidates do
		local entry = candidates[i]
		local smart = entry.smart or entry
		local weight = M.service_base_roam_weight(squad, smart) or 1
		local scoring = rawget(_G, "zhopa2_task_scoring")
		if scoring and type(scoring.roam_population_modifier) == "function" then
			weight = weight * scoring.roam_population_modifier(squad, M.obj_level(smart))
		end
		if scoring and type(scoring.roam_distance_modifier) == "function" then
			weight = weight * scoring.roam_distance_modifier(entry.hops)
		end
        if weight > 0 then
            local key = bases and bases.key(smart) or smart.id
            counts[key] = (counts[key] or 0) + 1
            weighted[#weighted+1] = {smart=smart, key=key, weight=weight}
        end
	end
    for _, entry in ipairs(weighted) do
        local weight = entry.weight / counts[entry.key]
        total = total + weight
        if math.random() * total < weight then selected = entry.smart end
    end
	return selected
end

local function base_camping_populate_score(squad, smart)
	if not (squad and smart and smart.id) then
		return nil
	end
	return cached_frame_pair("base_populate_score|" .. tostring(squad.id) .. "|" .. tostring(smart.id), function()
		local relation_rank = smart_owner_relation_rank(squad, smart)
		if not relation_rank then
			return nil
		end
		local capacity, free_slots = M.smart_settlement_capacity(squad, smart)
		if not capacity or not free_slots or squad_npc_count(squad) <= 0 or free_slots < 1 then
			return nil
		end
		return relation_rank, free_slots
	end)
end

local function count_rest_load_squad(squad, other, seen)
	if not (squad and other and other.id and other.id ~= squad.id) then
		return 0
	end
	if seen[other.id] then
		return 0
	end
	if squad_npc_count(other) <= 0 then
		return 0
	end
	if M.is_monster_squad(other) then
		return 0
	end
	if M.squad_relation_hostile(squad, other) then
		return 0
	end
	seen[other.id] = true
	return 1
end

function M.smart_rest_load(squad, smart)
	if not (squad and smart and smart.id) then
		return 0
	end
	return cached_frame_value("smart_rest_load|" .. tostring(squad.id) .. "|" .. tostring(smart.id), function()
		local seen = {}
		local count = 0
		local board_smart = SIMBOARD and SIMBOARD.smarts and SIMBOARD.smarts[smart.id] or nil
		if board_smart and board_smart.squads then
			for id in pairs(board_smart.squads) do
				count = count + count_rest_load_squad(squad, alife_object(id), seen)
			end
		end

		local target_level = M.obj_level(smart)
		local current_level = M.obj_level(squad)
		local levels = { target_level }
		if current_level and current_level ~= target_level then
			levels[#levels + 1] = current_level
		end

		local indexed = index_squads_on_levels(levels)
		for i = 1, #indexed do
			local other = indexed[i]
			if squad_targets_smart(other, smart) or squad_near_smart(other, smart) then
				count = count + count_rest_load_squad(squad, other, seen)
			end
		end
		return count
	end) or 0
end

local function smart_owner_hostile_or_unstable(squad, smart)
	local idx = index_mod()
	if not (idx and smart and smart.id) then
		return false
	end
	local ownership = idx.base_ownership and idx.base_ownership(smart) or nil
	if not ownership and idx.update_base_ownership then
		ownership = idx.update_base_ownership(smart)
	end
	if not ownership then
		return false
	end
	if ownership.state == "unstable" then
		return true
	end
	local squad_faction = M.squad_relation_faction(squad)
	local owner_faction = ownership.owner and (relation_faction_aliases[tostring(ownership.owner)] or ownership.owner) or nil
	if ownership.state == "owned" and owner_faction and squad_faction and owner_faction ~= squad_faction then
		return factions_hostile(squad_faction, owner_faction)
	end
	return false
end

local function safe_rest_smart(squad, smart)
	if smart_owner_hostile_or_unstable(squad, smart) then
		return false
	end
	if smart_has_hostile_squad(squad, smart) then
		return false
	end
	return true
end

local function hunt_profile_prey_ok(squad, profile, prey, hunter_faction)
	if prey == "stalker" then
		return profile and profile.is_monster ~= true
	elseif prey == "monster" then
		return profile and profile.is_monster == true
	elseif prey == "hostile_stalker" then
		return profile and profile.is_monster ~= true and factions_hostile(hunter_faction or M.squad_relation_faction(squad), profile.faction)
	elseif prey == "enemy" then
		return profile and (profile.is_monster == true or factions_hostile(hunter_faction or M.squad_relation_faction(squad), profile.faction))
	end
	return true
end

function M.valid_hunt_target(squad, target, opts)
	if not (squad and target and target.id and target.id ~= squad.id) then
		return false
	end
	if M.quest_protected_squad(squad) or M.quest_protected_squad(target) then
		return false
	end
	if (M.is_monster_squad(squad) and not M.mutant_cycle_active(squad))
		or (M.is_monster_squad(target) and not M.mutant_cycle_active(target))
	then
		return false
	end
	local profile = hunt_target_profile(target)
	if not (profile and profile.ok) then
		return false
	end
	if safe_zone_squad(squad) then
		return false
	end

	opts = opts or {}
	local current_level = opts.current_level or M.obj_level(squad)
	local hunter_faction = opts.hunter_faction or M.squad_relation_faction(squad)
	local target_level = profile.level
	local neighbors = opts.neighbors or (mode_needs_neighbors(opts.level_mode) and M.nearby_levels(current_level) or nil)
	if not level_mode_ok(opts.level_mode or "current_or_nearby", current_level, target_level, neighbors, squad, target) then
		return false
	end

	if not hunt_profile_prey_ok(squad, profile, opts.prey, hunter_faction) then
		return false
	end
	if not profile.is_monster and profile.near_base == nil then
		profile.near_base = target_near_base_smart(target, target_level) == true
	end
	if profile.near_base == true then
		return false
	end

	local target_smart = profile.smart
	if is_blacklisted_for_hunt(squad, target_level, target_smart) then
		return false
	end
	if is_blacklisted_for_hunt(target, target_level, target_smart) then
		return false
	end

	if not opts.ignore_recent then
		local mem = memory_mod()
		if mem and type(mem.recent_has_target) == "function" and mem.recent_has_target(squad, target.id) then
			return false
		end
	end
	return true
end

function M.valid_revenge_target(squad, target, opts)
	if not (squad and target and target.id and target.id ~= squad.id) then
		return false
	end
	if M.quest_protected_squad(squad) or M.quest_protected_squad(target) then
		return false
	end
	if (M.is_monster_squad(squad) and not M.mutant_cycle_active(squad))
		or (M.is_monster_squad(target) and not M.mutant_cycle_active(target))
	then
		return false
	end
	if not (SIMBOARD and SIMBOARD.squads and SIMBOARD.squads[target.id]) then
		return false
	end
	if not is_common_sim_squad(target) then
		return false
	end
	if target.disabled or not is_online_offline_group(target) or squad_npc_count(target) <= 0 then
		return false
	end
	if safe_zone_squad(squad) or safe_zone_squad(target) then
		return false
	end
	if get_object_story_id and get_object_story_id(target.id) then
		return false
	end
	if axr_companions and axr_companions.companion_squads and axr_companions.companion_squads[target.id] then
		return false
	end

	opts = opts or {}
	local current_level = opts.current_level or M.obj_level(squad)
	local target_level = M.obj_level(target)
	local neighbors = opts.neighbors or (mode_needs_neighbors(opts.level_mode) and M.nearby_levels(current_level) or nil)
	if not level_mode_ok(opts.level_mode or "current_or_nearby", current_level, target_level, neighbors, squad, target) then
		return false
	end

	local target_smart = target.smart_id and alife_object(target.smart_id) or nil
	if is_blacklisted_for_hunt(squad, target_level, target_smart) then
		return false
	end
	if is_blacklisted_for_hunt(target, target_level, target_smart) then
		return false
	end
	return true
end

function M.index_squads_for_options(options, levels)
	options = options or {}
	levels = levels or levels_for_options(options)
	return index_squads_on_levels(levels)
end

local function hunt_candidate_pool(squad, options, levels)
	options = options or {}
	levels = levels or levels_for_options(options)
	local prey_key = options.prey
	if type(prey_key) == "table" then
		prey_key = list_key(prey_key)
	end
	local hunter_faction = options.hunter_faction
	local cache_key = table.concat({
		"hunt_candidate_pool",
		tostring(options.level_mode or "current_or_nearby"),
		tostring(options.current_level or ""),
		list_key(levels),
		tostring(prey_key or ""),
		tostring(hunter_faction or ""),
	}, "|")

	local now = now_ms()
	cleanup_runtime_hunt_cache(now)
	local cached = hunt_candidate_cache[cache_key]
	if cached and (tonumber(cached.expires) or 0) > now then
		local out = {}
		local ids = cached.ids or {}
		for i = 1, #ids do
			local target = alife_object(ids[i])
			if target then
				out[#out + 1] = target
			end
		end
		return out
	end

	return cached_frame_value(cache_key, function()
		local candidates = {}
		local ids = {}
		local indexed = M.index_squads_for_options(options, levels)
		for i = 1, #indexed do
		local target = indexed[i]
		local profile = hunt_target_profile(target)
		if profile and profile.ok then
			local prey_ok = hunt_profile_prey_ok(squad, profile, options.prey, hunter_faction)
			if prey_ok then
					candidates[#candidates + 1] = target
					ids[#ids + 1] = target.id
				end
			end
		end
		hunt_candidate_cache[cache_key] = {
			expires = now + HUNT_RUNTIME_CACHE_TTL_MS,
			ids = ids,
		}
		return candidates
	end) or {}
end

function M.collect_hunt_targets(squad, opts)
	local candidates = {}

	local options = opts or {}
	options.current_level = options.current_level or M.obj_level(squad)
	ensure_option_neighbors(options)
	local levels = levels_for_options(options)

	options.hunter_faction = options.hunter_faction or M.squad_relation_faction(squad)
	local indexed = hunt_candidate_pool(squad, options, levels)
	for i = 1, #indexed do
		local target = indexed[i]
		if M.valid_hunt_target(squad, target, options) then
			candidates[#candidates + 1] = target
		end
	end
	return candidates
end

local function squad_distance_uncached(squad, target)
	local tonum = tonumber
	if not (squad and target) then
		return nil
	end
	if squad.position and target.position and M.obj_level(squad) == M.obj_level(target) then
		local ok, dist = pcall(function()
			return squad.position:distance_to(target.position)
		end)
		if ok and tonum(dist) then
			return tonum(dist)
		end
	end
	if utils_obj and type(utils_obj.graph_distance) == "function" and squad.m_game_vertex_id and target.m_game_vertex_id then
		local ok, dist = pcall(utils_obj.graph_distance, squad.m_game_vertex_id, target.m_game_vertex_id)
		if ok and tonum(dist) then
			return tonum(dist)
		end
	end
	return nil
end

local function squad_distance(squad, target)
	if not (squad and target) then
		return nil
	end
	return cached_frame_value("distance|" .. obj_cache_key(squad) .. "|" .. obj_cache_key(target), function()
		return squad_distance_uncached(squad, target)
	end)
end

local function route_smart_ok(squad, smart, target_level)
	if not (squad and smart and smart.id and target_level) then
		return false
	end
	if smart.disabled or smart.respawn_only_smart then
		return false
	end
	if M.obj_level(smart) ~= target_level then
		return false
	end

	local c = cfg()
	if c and type(c.is_level_blacklisted_for_squad) == "function" and c.is_level_blacklisted_for_squad(squad, target_level) then
		return false
	end
	if c and type(c.is_smart_blacklisted_for_squad) == "function" and c.is_smart_blacklisted_for_squad(squad, smart, target_level) then
		return false
	end
	return true
end

local function smart_from_target_id(target_id)
	local smart = target_id and alife_object(target_id) or nil
	if smart and smart.clsid and clsid then
		local ok, class_id = pcall(smart.clsid, smart)
		if ok and class_id == clsid.smart_terrain then
			return smart
		end
	end
	return nil
end

local function target_route_smart(squad, target, target_level)
	local route_ids = { target.assigned_target_id, target.current_target_id, target.smart_id }
	for i = 1, #route_ids do
		local smart = smart_from_target_id(route_ids[i])
		if route_smart_ok(squad, smart, target_level) then
			return smart
		end
	end

	local best
	local best_dist = 100000000
	local candidates = index_smarts_on_levels({ target_level })
	for i = 1, #candidates do
		local smart = candidates[i]
		if route_smart_ok(squad, smart, target_level) then
			local dist = squad_distance(target, smart) or 100000000
			if dist < best_dist then
				best = smart
				best_dist = dist
			end
		end
	end
	return best
end

local function actor_server_object()
	local sim_fn = rawget(_G, "alife")
	if type(sim_fn) ~= "function" then
		return nil
	end
	local sim = sim_fn()
	return sim and sim:actor() or nil
end

function M.actor_script_target(squad, opts)
	opts = opts or {}
	local actor = actor_server_object()
	if not actor then
		return nil, "actor_target_missing"
	end
	return cached_frame_pair("actor_script_target|" .. obj_cache_key(squad) .. "|" .. obj_cache_key(actor) .. "|" .. bool_key(opts.allow_cross_level == false), function()
		if M.obj_same_level(squad, actor) then
			return AC_ID or 0, "actor_direct"
		end
		if opts.allow_cross_level == false then
			return nil, "actor_target_offlevel"
		end

		local actor_level = M.obj_level(actor)
		local smart = target_route_smart(squad, actor, actor_level)
		if smart then
			return smart.id, "actor_route_smart"
		end
		return nil, "actor_target_no_route"
	end)
end

function M.hunt_script_target(squad, target, opts)
	opts = opts or {}
	local prey_key = opts.prey
	if type(prey_key) == "table" then
		prey_key = list_key(prey_key)
	end
	return cached_frame_pair("hunt_script_target|" .. obj_cache_key(squad) .. "|" .. obj_cache_key(target) .. "|" .. tostring(prey_key or "") .. "|" .. bool_key(opts.allow_cross_level == false), function()
		if not M.valid_hunt_target(squad, target, { level_mode = "any", prey = opts.prey, ignore_recent = true }) then
			return nil, "hunt_target_invalid"
		end
		if M.obj_same_level(squad, target) then
			return target.id, "hunt_direct_squad"
		end
		if opts.allow_cross_level == false then
			return nil, "hunt_target_offlevel"
		end

		local target_level = M.obj_level(target)
		local smart = target_route_smart(squad, target, target_level)
		if smart then
			return smart.id, "hunt_route_smart"
		end
		return nil, "hunt_target_no_route"
	end)
end

function M.revenge_script_target(squad, target, opts)
	opts = opts or {}
	return cached_frame_pair("revenge_script_target|" .. obj_cache_key(squad) .. "|" .. obj_cache_key(target) .. "|" .. bool_key(opts.allow_cross_level == false), function()
		if not M.valid_revenge_target(squad, target, { level_mode = "any" }) then
			return nil, "revenge_target_invalid"
		end
		if M.obj_same_level(squad, target) then
			return target.id, "revenge_direct_squad"
		end
		if opts.allow_cross_level == false then
			return nil, "revenge_target_offlevel"
		end

		local target_level = M.obj_level(target)
		local smart = target_route_smart(squad, target, target_level)
		if smart then
			return smart.id, "revenge_route_smart"
		end
		return nil, "revenge_target_no_route"
	end)
end

local function pick_hunt_target_once(squad, options)
	options.current_level = options.current_level or M.obj_level(squad)
	ensure_option_neighbors(options)
	local levels = levels_for_options(options)
	local signature = hunt_options_signature(squad, options, levels)

	return cached_frame_value("pick_hunt_target_once|" .. signature, function()
		local best
		local best_dist
		local best_priority = -1
		local idx = index_mod()
		local hunter_is_monster = M.is_monster_squad(squad)
		options.hunter_faction = options.hunter_faction or M.squad_relation_faction(squad)
		local indexed = hunt_candidate_pool(squad, options, levels)
		for i = 1, #indexed do
			local target = indexed[i]
			if M.valid_hunt_target(squad, target, options) then
				local dist = squad_distance(squad, target) or 100000000
				local priority = 0
				local profile = hunt_target_profile(target)
				if idx and type(idx.squad_has_artifact_cargo) == "function" and not hunter_is_monster and profile and profile.is_monster ~= true and idx.squad_has_artifact_cargo(target) then
					priority = 1
				end
				if priority > best_priority or (priority == best_priority and (not best_dist or dist < best_dist)) then
					best = target
					best_dist = dist
					best_priority = priority
				end
			end
		end
		return best
	end)
end

function M.pick_hunt_target(squad, opts)
	local options = {}
	for k, v in pairs(opts or {}) do
		options[k] = v
	end
	options.current_level = options.current_level or M.obj_level(squad)
	options.hunter_faction = options.hunter_faction or M.squad_relation_faction(squad)
	ensure_option_neighbors(options)
	local levels = levels_for_options(options)
	local signature = hunt_options_signature(squad, options, levels)
	local runtime_key = table.concat({
		"pick_hunt_target",
		signature,
		tostring(options.hunter_faction or ""),
	}, "|")
	local now = now_ms()
	cleanup_runtime_hunt_cache(now)
	local cached = hunt_pick_cache[runtime_key]
	if cached and (tonumber(cached.expires) or 0) > now then
		local cached_id = cached.target_id
		if cached_id == false then
			return nil
		end
		local target = cached_id and alife_object(cached_id) or nil
		if target and M.valid_hunt_target(squad, target, options) then
			return target
		end
		hunt_pick_cache[runtime_key] = nil
	end

	return cached_frame_value("pick_hunt_target|" .. signature, function()
		local best = pick_hunt_target_once(squad, options)
		if not best and options.allow_recent_fallback == true and options.ignore_recent ~= true then
			local fallback = {}
			for k, v in pairs(options) do
				fallback[k] = v
			end
			fallback.ignore_recent = true
			best = pick_hunt_target_once(squad, fallback)
		end
		hunt_pick_cache[runtime_key] = {
			expires = now + HUNT_RUNTIME_CACHE_TTL_MS,
			target_id = best and best.id or false,
		}
		return best
	end)
end

function M.valid_smart(squad, smart, opts)
	if not (squad and smart and smart.id and smart.id ~= squad.id) then
		return false
	end
	if smart.disabled or smart.respawn_only_smart then
		return false
	end
	opts = opts or {}
	if opts.exclude_current and smart.id == squad.smart_id then
		return false
	end
	local bases = opts.service_roam and not M.is_monster_squad(squad) and rawget(_G, "zhopa2_bases")
	if opts.exclude_current and bases and alife_object then
		local current_id = tonumber(squad.smart_id)
		-- Travelling/unregistered squads have no current smart; 65535 is the engine sentinel.
		if current_id and current_id >= 0 and current_id < 65535
			and bases.same(alife_object(current_id), smart) then return false end
	end

	local current_level = opts.current_level or M.obj_level(squad)
	local target_level = M.obj_level(smart)
	local neighbors = opts.neighbors or (mode_needs_neighbors(opts.level_mode) and M.nearby_levels(current_level) or nil)
	if not level_mode_ok(opts.level_mode, current_level, target_level, neighbors, squad, smart) then
		return false
	end

	local c = cfg()
	if c and type(c.is_level_blacklisted_for_squad) == "function" and c.is_level_blacklisted_for_squad(squad, target_level) then
		return false
	end
	if c and type(c.is_smart_blacklisted_for_squad) == "function" and c.is_smart_blacklisted_for_squad(squad, smart, target_level) then
		return false
	end
	if not smart_kind_ok(squad, smart, opts.kind) then
		return false
	end
	if opts.safe_rest and not safe_rest_smart(squad, smart) then
		return false
	end
	local service_weight = opts.service_roam and M.service_base_roam_weight(squad, smart) or nil
	if service_weight == 0 then return false end
	if not service_weight and opts.populate and smart_population(smart.id) >= (smart.max_population or 1) then
		return false
	end
	if opts.has_prey and not has_prey_squad(squad, smart) then
		return false
	end

	-- Service settlement uses live ownership and job capacity, not the base's old faction props.
	if not service_weight and not opts.skip_target_precondition and smart.target_precondition and not smart:target_precondition(squad, opts.ignore_population == true, opts.skip_props == true) then
		return false
	end
	if not opts.skip_prior and smart.evaluate_prior and smart:evaluate_prior(squad) <= 0 then
		return false
	end
	return true
end

function M.safe_rest_target_valid(squad, target_id)
	local smart = target_id and alife_object(tonumber(target_id)) or nil
	if not smart then
		return false
	end
	return M.valid_smart(squad, smart, {
		level_mode = "any",
		ignore_population = true,
		skip_prior = true,
		safe_rest = true,
		skip_target_precondition = true,
	})
end

function M.index_smarts_for_options(options, levels)
	options = options or {}
	levels = levels or levels_for_options(options)
	return index_smarts_on_levels(levels, options.kind)
end

local function valid_smart_cached(squad, smart, options, signature)
	if not (smart and smart.id) then
		return false
	end
	local key = "valid_smart|" .. tostring(signature or "") .. "|" .. tostring(smart.id)
	return cached_frame_value(key, function()
		return M.valid_smart(squad, smart, options)
	end) == true
end

function M.collect_smarts(squad, opts)
	local candidates = {}

	local options = opts or {}
	options.current_level = options.current_level or M.obj_level(squad)
	ensure_option_neighbors(options)
	local levels = levels_for_options(options)
	local limit = math.max(0, math.floor(tonumber(options.limit) or 0))
	local signature = smart_options_signature(squad, options, levels) .. "|limit|" .. tostring(limit)

	local cached = cached_frame_value("collect_smarts|" .. signature, function()
		local out, seen_bases = {}, {}
		local bases = options.service_roam and not M.is_monster_squad(squad) and rawget(_G, "zhopa2_bases")
		local indexed = M.index_smarts_for_options(options, levels)
		if bases then
			-- Sample physical bases before the limit; extra members must not increase inclusion probability.
			local buckets, keys = {}, {}
			for _, smart in ipairs(indexed) do
				local key = bases.key(smart)
				if not buckets[key] then buckets[key] = {}; keys[#keys+1] = key end
				buckets[key][#buckets[key]+1] = smart
			end
			while #keys > 0 and (limit == 0 or #out < limit) do
				local members = buckets[table.remove(keys, math.random(#keys))]
				local start = math.random(#members)
				for offset = 0, #members - 1 do
					local smart = members[((start + offset - 1) % #members) + 1]
					if valid_smart_cached(squad, smart, options, signature) then out[#out+1] = smart; break end
				end
			end
			return out
		end
		local count = #indexed
		if limit > 0 and count > 0 then
			local start = math.random(count)
			for offset = 0, count - 1 do
				local i = ((start + offset - 1) % count) + 1
				local smart = indexed[i]
				local key = bases and bases.key(smart) or (smart and smart.id) or i
                if not seen_bases[key] and valid_smart_cached(squad, smart, options, signature) then
                    seen_bases[key] = true
					out[#out + 1] = smart
					if #out >= limit then
						break
					end
				end
			end
		else
			for i = 1, count do
				local smart = indexed[i]
				local key = bases and bases.key(smart) or (smart and smart.id) or i
                if not seen_bases[key] and valid_smart_cached(squad, smart, options, signature) then
                    seen_bases[key] = true
					out[#out + 1] = smart
				end
			end
		end
		return out
	end)
	for i = 1, #(cached or {}) do
		candidates[i] = cached[i]
	end
	return candidates
end

function M.roam_level_hops(squad)
	local current = M.obj_level(squad)
	if not current then return {} end
	return cached_frame_value("roam_hops|" .. tostring(squad.id) .. "|" .. current, function()
		local hops, queue = {[current] = 0}, {current}
		local head = 1
		local c = cfg()
		-- The Zone graph is small; cap discovery to keep addon maps from making a decision unbounded.
		while head <= #queue and head <= 64 do
			local source = queue[head]
			local neighbors = M.nearby_levels(source).direct_list or {}
			for i = 1, #neighbors do
				local target = neighbors[i]
				local blocked = c and c.is_level_blacklisted_for_squad and c.is_level_blacklisted_for_squad(squad, target)
				if not blocked and hops[target] == nil and #queue < 64 then
					hops[target] = hops[source] + 1
					queue[#queue + 1] = target
				end
			end
			head = head + 1
		end
		return hops
	end)
end

function M.collect_roam_smarts(squad, opts, limit)
	local groups = {{}, {}, {}}
	for name, hops in pairs(M.roam_level_hops(squad)) do
		if hops > 0 or (opts.level_mode ~= "neighbor" and opts.level_mode ~= "nearby") then
			local group = hops == 0 and 1 or hops == 1 and 2 or 3
			groups[group][#groups[group] + 1] = {level = name, hops = hops}
		end
	end
	local out = {}
	local probes = 0
	limit = math.max(1, math.min(8, tonumber(limit) or 3))
	for round = 1, limit do
		for group = 1, 3 do
			local levels = groups[group]
			while #levels > 0 and #out < limit and probes < 12 do
				probes = probes + 1
				local entry = table.remove(levels, math.random(#levels))
				local options = {}
				for key, value in pairs(opts) do options[key] = value end
				options.level_mode, options.fallback_level_mode = "any", nil
				options.current_level = M.obj_level(squad)
				options.candidate_levels, options.limit = {entry.level}, 3
				local smarts = M.collect_smarts(squad, options)
				if #smarts > 0 then
					out[#out + 1] = {smart = smarts[math.random(#smarts)], hops = entry.hops}
					break
				end
			end
		end
		if #out >= limit then break end
	end
	return out
end

local function pick_smart_from_options(squad, opts)
	local options = opts or {}
	if options.service_roam and not M.is_monster_squad(squad) then
		return M.pick_roam_smart(squad, M.collect_roam_smarts(squad, options, 3))
	end
	options.current_level = options.current_level or M.obj_level(squad)
	ensure_option_neighbors(options)
	local levels = levels_for_options(options)
	local signature = smart_options_signature(squad, options, levels)
	local indexed = M.index_smarts_for_options(options, levels)
	local count = #indexed
	if count <= 0 then
		return nil
	end
	local start = math.random(count)
	for offset = 0, count - 1 do
		local index = ((start + offset - 1) % count) + 1
		local smart = indexed[index]
		if valid_smart_cached(squad, smart, options, signature) then
			return smart
		end
	end
	return nil
end

function M.pick_smart(squad, opts)
	return pick_smart_from_options(squad, opts)
end

local function artifact_clone_opts(src)
	local out = {}
	for k, v in pairs(src or {}) do
		out[k] = v
	end
	return out
end

function M.collect_artifact_targets(squad, opts)
	local idx = index_mod()
	if not (idx and type(idx.artifact_candidate_smarts_on_levels) == "function") then
		return {}
	end
	local options = artifact_clone_opts(opts or {})
	options.kind = "artefact"
	options.ignore_population = true
	options.skip_prior = true
	options.skip_target_precondition = true
	options.current_level = options.current_level or M.obj_level(squad)
	ensure_option_neighbors(options)
	local levels = levels_for_options(options)
	local signature = smart_options_signature(squad, options, levels) .. "|artifact|" .. tostring(idx.get_revision and idx.get_revision() or "")

	local candidates = idx.artifact_candidate_smarts_on_levels(levels, squad)
	local out = {}
	for i = 1, #(candidates or {}) do
		local entry = candidates[i]
		local smart = entry and entry.smart or nil
		if entry and entry.artifact_id and smart and valid_smart_cached(squad, smart, options, signature) then
			out[#out + 1] = {
				smart = smart,
				artifact_id = entry.artifact_id,
				zone = entry.zone,
				section = entry.section,
				level = entry.level,
				reason = entry.reason or "artefact_available",
				virtual = entry.virtual,
			}
		end
	end
	return out
end

function M.pick_artifact_target(squad, opts)
	local options = artifact_clone_opts(opts or {})
	local candidates = M.collect_artifact_targets(squad, options)
	local best
	local best_dist
	for i = 1, #candidates do
		local entry = candidates[i]
		local dist = squad_distance(squad, entry.smart) or 100000000
		if not best_dist or dist < best_dist then
			best = entry
			best_dist = dist
		end
	end
	if best then
		return best
	end

	if options.fallback_level_mode then
		local fallback = artifact_clone_opts(options)
		fallback.level_mode = options.fallback_level_mode
		fallback.fallback_level_mode = nil
		return M.pick_artifact_target(squad, fallback)
	end
	return nil
end

function M.pick_closest_smart(squad, opts)
	local candidates = M.collect_smarts(squad, opts)
	local best
	local best_dist
	for i = 1, #candidates do
		local smart = candidates[i]
		local dist = squad_distance(squad, smart) or 100000000
		if not best_dist or dist < best_dist then
			best = smart
			best_dist = dist
		end
	end
	return best
end

function M.pick_balanced_rest_smart(squad, opts)
	local candidates = M.collect_smarts(squad, opts)
	local best
	local best_load
	local best_dist
	for i = 1, #candidates do
		local smart = candidates[i]
		local load = M.smart_rest_load(squad, smart)
		local dist = squad_distance(squad, smart) or 100000000
		local service_weight = M.service_base_roam_weight(squad, smart)
		if service_weight and service_weight > 1 then dist = dist / service_weight end
		if not best
			or load < best_load
			or (load == best_load and dist < best_dist)
		then
			best = smart
			best_load = load
			best_dist = dist
		end
	end
	return best
end

function M.pick_base_camping_populate_smart(squad, opts)
	local options = opts or {}
	options.current_level = options.current_level or M.obj_level(squad)
	ensure_option_neighbors(options)
	local levels = levels_for_options(options)
	local idx = index_mod()
	local revision = idx and tonumber(idx.base_camping_revision) or 0
	local signature = smart_options_signature(squad, options, levels) .. "|base_rev|" .. tostring(revision)
	local now = now_ms()
	M.cleanup_base_populate_pick_cache(now)
	local runtime_cached = M.base_populate_pick_cache[signature]
	if runtime_cached and tonumber(runtime_cached.expires or 0) > now then
		return runtime_cached.smart_id and alife_object and alife_object(runtime_cached.smart_id) or nil
	end
	local cache_key = "pick_base_camping_populate_smart|" .. signature
	return cached_frame_value(cache_key, function()
		local candidates = base_camping_populate_candidates(squad, options)
		local best
		local best_level_rank
		local best_rank
		local best_free
		local best_dist
		for i = 1, #candidates do
			local smart = candidates[i]
			local relation_rank, free_slots = base_camping_populate_score(squad, smart)
			if relation_rank then
				local level_rank = options.base_populate_level_priority == true and 1 or base_camping_populate_level_rank(squad, smart, options)
				local dist = squad_distance(squad, smart) or 100000000
				if not best
				or level_rank < best_level_rank
				or (level_rank == best_level_rank and relation_rank < best_rank)
				or (level_rank == best_level_rank and relation_rank == best_rank and free_slots > best_free)
				or (level_rank == best_level_rank and relation_rank == best_rank and free_slots == best_free and dist < best_dist)
				then
					best = smart
					best_level_rank = level_rank
					best_rank = relation_rank
					best_free = free_slots
					best_dist = dist
				end
			end
		end
		M.base_populate_pick_cache[signature] = {
			expires = now + M.BASE_POPULATE_PICK_TTL_MS,
			smart_id = best and best.id or false,
		}
		return best
	end)
end

function M.base_camping_populate_target_valid(squad, smart)
	if not (squad and smart and smart.id) then
		return false
	end
	if not M.valid_smart(squad, smart, {
		level_mode = "any",
		kind = "base",
		ignore_population = true,
		skip_prior = true,
		safe_rest = true,
		skip_target_precondition = true,
	}) then
		return false
	end
	local targets = base_camping_target_map(squad, { smart })
	local smart_id = tonumber(smart.id) or smart.id
	local service_weight = M.service_base_roam_weight(squad, smart)
	return (targets[smart_id] == true or (service_weight and service_weight > 0))
		and base_camping_populate_score(squad, smart) ~= nil
end

function M.pick_final_prior_smart(squad, smart_or_list, opts)
	if not smart_or_list then
		return nil
	end
	opts = opts or {}
	if opts.skip_prior == true then
		local entry = (smart_or_list.id or smart_or_list.smart) and smart_or_list or smart_or_list[1]
		return entry and (entry.smart or entry) or nil
	end

	local list = smart_or_list
	if smart_or_list.id or smart_or_list.smart then
		list = { smart_or_list }
	end

	for i = 1, #list do
		local entry = list[i]
		local smart = entry and (entry.smart or entry) or nil
		if smart then
			if not smart.evaluate_prior or smart:evaluate_prior(squad) > 0 then
				return smart
			end
		end
	end
	return nil
end

local function clone_opts(src)
	local out = {}
	for k, v in pairs(src or {}) do
		out[k] = v
	end
	return out
end

function M.pick_weighted_smart(squad, opts, fallback_opts)
	local primary_opts = clone_opts(opts or {})

	local fallback_level_mode = primary_opts.fallback_level_mode
	local secondary_opts = fallback_opts
	if not secondary_opts and fallback_level_mode then
		secondary_opts = clone_opts(primary_opts)
		secondary_opts.level_mode = fallback_level_mode
		secondary_opts.fallback_level_mode = nil
	end

	local smart = M.pick_smart(squad, primary_opts)
	if smart then
		return smart
	end
	if secondary_opts then
		return M.pick_smart(squad, secondary_opts)
	end
	return nil
end

function M.pack_ids(list)
	local out = {}
	for i = 1, #list do
		out[i] = tostring(list[i])
	end
	return table.concat(out, ",")
end

function M.unpack_ids(value)
	local out = {}
	if type(value) ~= "string" or value == "" then
		return out
	end

	local parts = str_explode(value, ",")
	for i = 1, #parts do
		local id = tonumber(parts[i])
		if id then
			out[#out + 1] = id
		end
	end
	return out
end

function M.is_night()
	local hour = level and level.get_time_hours and level.get_time_hours() or 12
	return hour >= 21 or hour <= 5
end

function M.make_patrol(squad, kind, opts)
	opts = opts or {}
	local candidates = M.collect_smarts(squad, {
		level_mode = "same",
		kind = kind,
		ignore_population = true,
		exclude_current = true,
		skip_prior = true,
		service_roam = true,
	})
	if #candidates == 0 then
		return nil
	end

	local ids = {}
	while #candidates > 0 and #ids < MAX_PATROL_POINTS do
		local smart = M.pick_roam_smart(squad, candidates)
		if not smart then break end
		ids[#ids + 1] = smart.id
		for i = #candidates, 1, -1 do
			if candidates[i].id == smart.id then table.remove(candidates, i); break end
		end
	end
	if #ids == 0 then
		return nil
	end
	return ids
end

function M.invalidate_roam_cache(squad)
	-- Called on assignment/clear/patrol advance, so later decisions see incoming squads this frame.
	frame_cache_key = nil
	frame_cache = {}
	M.base_populate_pick_cache = {}
	local scoring = rawget(_G, "zhopa2_task_scoring")
	if squad and scoring and type(scoring.on_squad_population_changed) == "function" then
		scoring.on_squad_population_changed(squad)
	end
end

function M.on_master_disable()
	target_maps_cache = {}
	neighbors_cache = {}
	hunt_candidate_cache = {}
	hunt_pick_cache = {}
	hunt_cache_cleanup_at = 0
	frame_cache_key = nil
	frame_cache = {}
	M.base_populate_pick_cache = {}
	M.base_populate_pick_cache_cleanup_at = 0
	return true
end

_G.zhopa2_perception = M
return M
